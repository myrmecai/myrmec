# Myrmec Engine — environment variables
#
# Copy this file to `.env` (or set these vars in your shell / IDE / CI) and
# fill in real values. Never commit `.env`.
#
# Consumed by:
#   - Spring Boot startup (see src/main/resources/application.yml)
#   - the optional test-data seeder (gated by MYRMEC_LOAD_TEST_DATA=true)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/myrmec
DATABASE_USERNAME=myrmec
DATABASE_PASSWORD=secret

# ---------------------------------------------------------------------------
# Engine bootstrap admin (created on first start when both are set)
# ---------------------------------------------------------------------------
MYRMEC_ADMIN_EMAIL=
MYRMEC_ADMIN_PASSWORD=
MYRMEC_ADMIN_NAME=System Administrator

# ---------------------------------------------------------------------------
# Crypto — MUST be set in any non-dev deployment
# ---------------------------------------------------------------------------
# 32-byte secret used to encrypt stored model API keys and other credentials.
MYRMEC_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional test data (loaded on startup when enabled)
# ---------------------------------------------------------------------------
# Set to true to seed test providers, models, agent profiles and a test
# assistant on startup. Leave unset/false in production.
MYRMEC_LOAD_TEST_DATA=false

# Three test models: a primary orchestrator plus two sub-agents (coder,
# reviewer). Each model resolves its provider, model id, optional endpoint and
# API key from these env vars; the static metadata (name, context window,
# capabilities, …) comes from seed-data/optional/*.json.
#
# The provider code (MYRMEC_TEST_*_MODEL_PROVIDER) must match a `code` in
# seed-data/optional/model-providers.json.
#
# MYRMEC_TEST_*_MODEL_API_KEY may be left empty for keyless local providers
# (e.g. ollama, lm_studio, localai).
#
# MYRMEC_TEST_*_MODEL_ENDPOINT is optional per model; when set it overrides the
# provider base URL for that model.

# -- Primary orchestrator --
MYRMEC_TEST_PRIMARY_MODEL_PROVIDER=
MYRMEC_TEST_PRIMARY_MODEL_ID=
MYRMEC_TEST_PRIMARY_MODEL_ENDPOINT=
MYRMEC_TEST_PRIMARY_MODEL_API_KEY=

# -- Sub-agent 1: coder --
MYRMEC_TEST_SUBAGENT1_MODEL_PROVIDER=
MYRMEC_TEST_SUBAGENT1_MODEL_ID=
MYRMEC_TEST_SUBAGENT1_MODEL_ENDPOINT=
MYRMEC_TEST_SUBAGENT1_MODEL_API_KEY=

# -- Sub-agent 2: reviewer --
MYRMEC_TEST_SUBAGENT2_MODEL_PROVIDER=
MYRMEC_TEST_SUBAGENT2_MODEL_ID=
MYRMEC_TEST_SUBAGENT2_MODEL_ENDPOINT=
MYRMEC_TEST_SUBAGENT2_MODEL_API_KEY=

# -- Agent host registration key --
# The MANAGED agent host seeded for the mock agent. Must match the key the
# mock engine accepts (MOCK_ENGINE_REGISTRATION_KEYS, default myr_agent_test).
MYRMEC_TEST_REGISTRATION_KEY=myr_agent_test
MYRMEC_DEV_LOGIN_PAGE_ENABLED=true