<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      #95 — External API for Conversational Services (V1 core slice). This
      changeset introduces the `service_accounts` table: a machine principal,
      scoped to exactly one project, that drives Conversation Sessions over the
      `/api/v1/external/*` surface on behalf of its own end-users.

      Authentication is delegated to Keycloak via the `client-credentials`
      grant (OAuth 2.1) — Myrmec issues no API keys and stores no secret. The
      only credential mapping stored here is `keycloak_client_id` (the token's
      client/azp claim), resolved to this row at request time.

      The forward seam `conversations.service_account_id` (added without a FK
      in 20260621-09) is upgraded to a real foreign key now that the referenced
      table exists. `execution_snapshots.service_account_id` keeps NO FK by
      design (a missing reference must never abort a snapshot write).
    -->

    <changeSet id="20260621-12-create-service-accounts" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="service_accounts"/>
            </not>
        </preConditions>
        <comment>Service accounts — per-project machine principals for the External API (#95).</comment>

        <createTable tableName="service_accounts">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- A service account belongs to exactly one project; all assistants it may
                 open live in this project. -->
            <column name="project_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_service_account_project"
                             references="projects(id)"/>
            </column>
            <!-- Human-readable display name for admins. -->
            <column name="name" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <!-- The Keycloak client/azp claim a client-credentials token carries. Maps a
                 validated external token to this row. Unique across the platform. -->
            <column name="keycloak_client_id" type="varchar(255)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_service_account_keycloak_client_id"/>
            </column>
            <!-- Kill switch: FALSE → all external calls authenticating as this account are
                 rejected 403. Reversible. -->
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <!-- Per-account request rate limit (requests/minute). Enforced in #95a; stored
                 now so admin provisioning is complete. -->
            <column name="rate_limit_per_min" type="int" defaultValueNumeric="60">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_service_account_created_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260621-12-service-accounts-project-idx" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_service_account_project"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_service_account_project" tableName="service_accounts">
            <column name="project_id"/>
        </createIndex>
    </changeSet>

    <!-- Upgrade the forward seam from 20260621-09 into a real FK now that
         service_accounts exists. SET NULL on delete keeps historical conversations
         readable even if an account is ever removed (V1 disables, never deletes). -->
    <changeSet id="20260621-12-conversation-service-account-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="conversations" columnName="service_account_id"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="fk_conversation_service_account"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint constraintName="fk_conversation_service_account"
                                 baseTableName="conversations" baseColumnNames="service_account_id"
                                 referencedTableName="service_accounts" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
