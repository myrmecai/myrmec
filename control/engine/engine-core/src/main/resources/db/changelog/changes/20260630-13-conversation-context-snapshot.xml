<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      AI Context Management — Add context_snapshot to conversations.
      Written once at conversation creation when contextPinning = PINNED_AT_START.
      See governance-and-versioning.md §2.8.
    -->

    <changeSet id="20260630-13-conversation-context-snapshot" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="context_snapshot"/>
            </not>
        </preConditions>
        <addColumn tableName="conversations">
            <column name="context_snapshot" type="jsonb"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>