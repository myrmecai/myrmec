<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Pin / unpin conversation messages.

        Adds a ``pinned`` boolean flag to ``conversation_messages`` so a
        participant can mark salient turns (a decision, a snippet, an
        instruction) and later filter the transcript to "pinned only".
        This is a per-message UI affordance — it does NOT change context
        assembly (``pinned_facts`` on the conversation row remains the
        engine-level mechanism for that). Default false keeps every
        existing row unpinned.
    -->
    <changeSet id="20260620-04-01" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversation_messages" columnName="pinned"/>
            </not>
        </preConditions>
        <addColumn tableName="conversation_messages">
            <column name="pinned" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260620-04-02" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_conv_messages_pinned"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_conv_messages_pinned"
                     tableName="conversation_messages">
            <column name="conversation_id"/>
            <column name="pinned"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
