<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ================================================================
         system_settings
         ================================================================ -->
    <changeSet id="reference-data-table" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="reference_data" />
            </not>
        </preConditions>
        <createTable tableName="reference_data">
            <column name="reference_key" type="varchar(100)">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="parent_key" type="varchar(100)">
                <constraints nullable="true" />
            </column>
            <column name="category" type="varchar(50)">
                <constraints nullable="false" />
            </column>
            <column name="display_name" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="description" type="text" />
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
    <changeSet id="system-settings-table" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="system_settings" />
            </not>
        </preConditions>

        <createTable tableName="system_settings">
            <column name="setting_key" type="varchar(120)">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="value_type" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="setting_value" type="clob" />
            <column name="description" type="varchar(500)" />
            <column name="updated_by" type="varchar(120)" />
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>