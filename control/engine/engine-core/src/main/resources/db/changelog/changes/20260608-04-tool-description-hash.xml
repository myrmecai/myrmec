<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Phase 9f - tool description hash pinning + admin re-approval drift.

      The risk: an MCP server (or any external tool registry) updates its
      `description` between the moment an admin approves the tool and the
      moment an agent calls it. Since the model decides "should I call this
      tool" based on the description, a malicious description rewrite is
      a turnkey privilege-escalation. Solution: pin the SHA-256 of the
      approved description, recompute on every update, and gate execution
      until an admin re-approves.

      All three columns are nullable so existing seeded rows continue to
      work; ToolService treats null hash as "drift, needs approval" once
      enforcement is enabled.
    -->

    <changeSet id="20260608-04-tool-description-hash" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tools" columnName="description_hash"/>
            </not>
        </preConditions>
        <addColumn tableName="tools">
            <column name="description_hash" type="varchar(64)">
                <constraints nullable="true"/>
            </column>
            <column name="description_approved_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="description_approved_by" type="uuid">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
