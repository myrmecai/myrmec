<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Phase 8c - 120% kill switch (#44).
      
      When consumption hits 120% of the limit, the quota auto-pauses.
      Requires explicit admin action (via resume endpoint) to lift the pause.
      Used to enforce hard caps on regulated/high-risk scopes.
    -->

    <changeSet id="20260622-03-quota-pause-resume" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="quotas" columnName="paused_at"/>
            </not>
        </preConditions>
        <addColumn tableName="quotas">
            <column name="paused_at" type="timestamp"/>
            <column name="paused_by" type="uuid"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
