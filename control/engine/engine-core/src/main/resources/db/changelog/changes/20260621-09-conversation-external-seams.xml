<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      #96 — V1 design seams on the conversation/session container for the
      External API (#95) and Moderated Conversations (#100). The design docs
      name this table `conversation_sessions`; in the live schema the durable
      session container is `conversations`, so the seam columns land there.

      Every column is additive and either nullable or NOT NULL with a default,
      so pre-existing conversations keep working untouched and zero V1 runtime
      behaviour changes. `service_account_id` carries NO foreign key — the
      `service_accounts` table is introduced later by #95; it is a forward seam
      exactly like `agent_profile_version_id` (20260621-08).
    -->

    <!-- ===== External-API seams (#95) ===== -->

    <changeSet id="20260621-09-conversation-source" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="source"/>
            </not>
        </preConditions>
        <addColumn tableName="conversations">
            <!-- WEB_UI | EXTERNAL_API. Where the conversation was started from. -->
            <column name="source" type="varchar(20)" defaultValue="WEB_UI">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260621-09-conversation-external-user-ref" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="external_user_ref"/>
            </not>
        </preConditions>
        <addColumn tableName="conversations">
            <!-- Opaque caller-side end-user identity for EXTERNAL_API sessions. NULL for WEB_UI. -->
            <column name="external_user_ref" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260621-09-conversation-service-account-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="service_account_id"/>
            </not>
        </preConditions>
        <addColumn tableName="conversations">
            <!-- Forward seam: integration that created the session. No FK yet (service_accounts lands in #95). -->
            <column name="service_account_id" type="uuid"/>
        </addColumn>
    </changeSet>

    <!-- ===== Moderated-Conversation seams (#100) ===== -->

    <changeSet id="20260621-09-conversation-parent-conversation-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="parent_conversation_id"/>
            </not>
        </preConditions>
        <addColumn tableName="conversations">
            <!-- Self-reference: the public session a private moderator session hangs off. NULL = standalone. -->
            <column name="parent_conversation_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_conversation_parent"
                             references="conversations(id)"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260621-09-conversation-role-in-thread" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="role_in_thread"/>
            </not>
        </preConditions>
        <addColumn tableName="conversations">
            <!-- STANDALONE | PUBLIC_FACING | MODERATOR_PRIVATE. V1 always STANDALONE. -->
            <column name="role_in_thread" type="varchar(30)" defaultValue="STANDALONE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
