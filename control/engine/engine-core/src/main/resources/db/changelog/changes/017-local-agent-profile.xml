<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="017-local-agent-profile" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="agent_profiles"/>
                <tableExists tableName="agent_profile_versions"/>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM agent_profiles WHERE name = 'Myrmec Local Agent'</sqlCheck>
            </and>
        </preConditions>

        <comment>Seed the default local agent profile (system, conversational)</comment>

        <!-- Zone 1: identity/admin row -->
        <loadData
            tableName="agent_profiles"
            file="db/changelog/data/agent_profiles.csv"
            separator=","
            encoding="UTF-8"
            relativeToChangelogFile="false">
            <column name="id" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="description" type="STRING"/>
            <column name="is_system" type="BOOLEAN"/>
            <column name="addendum_allowed" type="BOOLEAN"/>
            <column name="status" type="STRING"/>
            <column name="created_at" type="DATE"/>
            <column name="updated_at" type="DATE"/>
        </loadData>

        <!-- Zone 2: published behaviour contract v1 -->
        <loadData
            tableName="agent_profile_versions"
            file="db/changelog/data/agent_profile_versions.csv"
            separator=","
            encoding="UTF-8"
            relativeToChangelogFile="false">
            <column name="id" type="STRING"/>
            <column name="profile_id" type="STRING"/>
            <column name="version_number" type="NUMERIC"/>
            <column name="status" type="STRING"/>
            <column name="capabilities" type="STRING"/>
            <column name="default_model" type="STRING"/>
            <column name="system_prompt" type="STRING"/>
            <column name="interaction_mode" type="STRING"/>
            <column name="command_templates" type="STRING"/>
            <column name="approval_policy" type="STRING"/>
            <column name="required_isolation" type="STRING"/>
            <column name="git_policy" type="STRING"/>
            <column name="workspace_retention_seconds" type="NUMERIC"/>
            <column name="approval_request_ttl_seconds" type="NUMERIC"/>
            <column name="published_at" type="DATE"/>
            <column name="published_by" type="STRING"/>
            <column name="created_at" type="DATE"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
