<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Phase 8d - Quota change audit history (#47).
      
      Append-only table recording every quota limit mutation: who changed it,
      when, old limit, new limit. Paired with the existing AuditLogService
      for compliance/regulated-buyer audit trails.
      
      Rationale: Required for regulated buyers (PCI, SOX, etc.) to prove
      quota limits have not been tampered with. Separation of concerns:
      this table is append-only and focused on quota mutations, whereas
      AuditLogService covers broader platform events.
    -->

    <changeSet id="20260622-04-quota-change-history" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="quota_change_history"/>
            </not>
        </preConditions>
        <createTable tableName="quota_change_history">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quota_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_quota_change_history_quota"
                             references="quotas(id)"/>
            </column>
            <column name="changed_by" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="old_limit_amount" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="new_limit_amount" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="changed_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260622-04-quota-change-history-idx-quota" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_quota_change_history_quota"/>
            </not>
        </preConditions>
        <createIndex tableName="quota_change_history" indexName="idx_quota_change_history_quota">
            <column name="quota_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260622-04-quota-change-history-idx-changed-at" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_quota_change_history_changed_at"/>
            </not>
        </preConditions>
        <createIndex tableName="quota_change_history" indexName="idx_quota_change_history_changed_at">
            <column name="changed_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
