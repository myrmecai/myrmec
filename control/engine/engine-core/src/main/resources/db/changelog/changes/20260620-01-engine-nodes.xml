<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Slice 4a — Node registry (multi-replica routing foundation).

        ``engine_nodes`` is the replica self-registration / discovery table
        (agent-concurrency §9.7). Each engine replica registers itself on
        startup (node id + in-cluster address), heartbeats on a timer, and a
        reaper marks stale replicas DOWN. The ownership registry stays
        DB-neutral SQL — no proprietary features — so cross-node routing
        works on any supported database.

        ``node_id`` is a NATURAL key (the pod's stable DNS name / configured
        id), consistent with the reference-data PK rule: it is infrastructure
        identity the replica knows about itself, not a generated surrogate.

        The three owner-pointer columns added here are NULLABLE and unused on
        a single node (everything resolves to "self"): they record which
        replica owns each socket so a turn that lands on any replica can be
        routed to the owner.
          * ``agent_hosts.control_node_id`` — replica holding the Host's
            control socket.
          * ``agents.home_node_id``         — replica holding the Agent's
            conversation socket.
          * ``conversations.home_node_id``  — replica holding the client's
            live conversation connection.
          * ``conversations.agent_host_id`` — current/last serving Host
            (denormalized durable machine; the ephemeral worker agent_id is
            deliberately NOT denormalized — see conversation-observability §4).
    -->

    <changeSet id="20260620-01-create-engine-nodes" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="engine_nodes"/>
            </not>
        </preConditions>
        <comment>Engine replica registry — self-registration + heartbeat + reap.</comment>

        <createTable tableName="engine_nodes">
            <!-- Natural key: the pod's stable DNS name / configured node id. -->
            <column name="node_id" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- host:port the replica is reachable at, in-cluster (pod address). -->
            <column name="address" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <!-- UP / DRAINING / DOWN -->
            <column name="status" type="varchar(20)" defaultValue="UP">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_heartbeat_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_engine_nodes_status_heartbeat" tableName="engine_nodes">
            <column name="status"/>
            <column name="last_heartbeat_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260620-01-agent-hosts-control-node" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="agent_hosts" columnName="control_node_id"/>
            </not>
        </preConditions>
        <comment>Replica holding this Host's control socket (null = unbound / single-node).</comment>

        <addColumn tableName="agent_hosts">
            <column name="control_node_id" type="varchar(255)"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="agent_hosts"
                baseColumnNames="control_node_id"
                constraintName="fk_agent_hosts_control_node"
                referencedTableName="engine_nodes"
                referencedColumnNames="node_id"
                onDelete="SET NULL"/>

        <createIndex indexName="idx_agent_hosts_control_node" tableName="agent_hosts">
            <column name="control_node_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260620-01-agents-home-node" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="agents" columnName="home_node_id"/>
            </not>
        </preConditions>
        <comment>Replica holding this Agent's conversation socket (null = unbound / single-node).</comment>

        <addColumn tableName="agents">
            <column name="home_node_id" type="varchar(255)"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="agents"
                baseColumnNames="home_node_id"
                constraintName="fk_agents_home_node"
                referencedTableName="engine_nodes"
                referencedColumnNames="node_id"
                onDelete="SET NULL"/>

        <createIndex indexName="idx_agents_home_node" tableName="agents">
            <column name="home_node_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260620-01-conversations-home-node" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="home_node_id"/>
            </not>
        </preConditions>
        <comment>Replica holding the client connection + current/last serving Host (denormalized).</comment>

        <addColumn tableName="conversations">
            <column name="home_node_id" type="varchar(255)"/>
            <column name="agent_host_id" type="uuid"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="conversations"
                baseColumnNames="home_node_id"
                constraintName="fk_conversations_home_node"
                referencedTableName="engine_nodes"
                referencedColumnNames="node_id"
                onDelete="SET NULL"/>

        <addForeignKeyConstraint
                baseTableName="conversations"
                baseColumnNames="agent_host_id"
                constraintName="fk_conversations_agent_host"
                referencedTableName="agent_hosts"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <createIndex indexName="idx_conversations_home_node" tableName="conversations">
            <column name="home_node_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
