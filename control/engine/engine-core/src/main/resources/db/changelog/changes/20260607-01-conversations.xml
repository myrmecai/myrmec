<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Phase 6a — Sessions schema.

        ``conversations`` is the durable container for an interactive chat
        between a user, zero-or-more other users (multi-viewer), and zero-or-
        more agents. ``conversation_messages`` is the append-only event log
        keyed by ``sequence_no`` (monotonic per conversation) so replay can
        rebuild state deterministically. ``conversation_participants`` is the
        ACL — who is allowed to read/write.

        ``agent_profiles.interaction_mode`` (#7) declares whether a profile
        runs in ONE_SHOT mode (existing workflow path) or CONVERSATIONAL
        mode (new sessions path). Default ONE_SHOT preserves existing
        behaviour for already-seeded profiles.
    -->

    <changeSet id="20260607-01-create-conversations" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="conversations"/>
            </not>
        </preConditions>
        <comment>Conversations — top-level durable session container.</comment>

        <createTable tableName="conversations">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_conversation_project"
                             references="projects(id)"/>
            </column>
            <column name="agent_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_conversation_agent"
                             references="agent_hosts(id)"/>
            </column>
            <column name="title" type="varchar(500)"/>
            <!-- ACTIVE / ARCHIVED / DELETED -->
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <!-- Per-conversation overrides (Phase 6d). NULL means "inherit profile". -->
            <column name="system_prompt_override" type="text"/>
            <column name="pinned_facts" type="text"/>
            <column name="created_by" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_conversation_created_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260607-01-conversations-indexes" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_conversation_project_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_conversation_project_id" tableName="conversations">
            <column name="project_id"/>
        </createIndex>
        <createIndex indexName="idx_conversation_created_by" tableName="conversations">
            <column name="created_by"/>
        </createIndex>
        <createIndex indexName="idx_conversation_status_updated" tableName="conversations">
            <column name="status"/>
            <column name="updated_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260607-01-create-conversation-messages" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="conversation_messages"/>
            </not>
        </preConditions>
        <comment>Append-only message log. sequence_no is unique per conversation.</comment>

        <createTable tableName="conversation_messages">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="conversation_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_message_conversation"
                             references="conversations(id)"/>
            </column>
            <!-- Monotonic per conversation; assigned by the engine. -->
            <column name="sequence_no" type="bigint">
                <constraints nullable="false"/>
            </column>
            <!-- USER / ASSISTANT / SYSTEM / TOOL / APPROVAL_REQUEST / APPROVAL_RESPONSE -->
            <column name="role" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <!--
                NULL author_user_id + NULL author_agent_id is valid for
                SYSTEM rows. Otherwise exactly one is set.
            -->
            <column name="author_user_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_message_author_user"
                             references="users(id)"/>
            </column>
            <column name="author_agent_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_message_author_agent"
                             references="agent_hosts(id)"/>
            </column>
            <column name="content" type="text"/>
            <!-- model_code is informational — actual usage rolls up via task_metrics. -->
            <column name="model_code" type="varchar(50)"/>
            <column name="token_count" type="integer"/>
            <!-- For TOOL rows: pointer to the tool_call payload + result. -->
            <column name="tool_call_id" type="varchar(100)"/>
            <column name="payload_json" type="text"/>
            <!-- Optional linkage for branched / regenerated turns. -->
            <column name="parent_message_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_message_parent"
                             references="conversation_messages(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260607-01-conversation-messages-indexes" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_message_conversation_sequence"/>
            </not>
        </preConditions>
        <!-- Monotonic ordering + uniqueness within a conversation. -->
        <createIndex indexName="uq_message_conversation_sequence"
                     tableName="conversation_messages" unique="true">
            <column name="conversation_id"/>
            <column name="sequence_no"/>
        </createIndex>
        <createIndex indexName="idx_message_conversation_created"
                     tableName="conversation_messages">
            <column name="conversation_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260607-01-create-conversation-participants" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="conversation_participants"/>
            </not>
        </preConditions>
        <comment>Multi-viewer ACL. Each row grants one user a role in one conversation.</comment>

        <createTable tableName="conversation_participants">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="conversation_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_participant_conversation"
                             references="conversations(id)"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_participant_user"
                             references="users(id)"/>
            </column>
            <!-- OWNER / EDITOR / VIEWER -->
            <column name="role" type="varchar(20)" defaultValue="VIEWER">
                <constraints nullable="false"/>
            </column>
            <column name="joined_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260607-01-conversation-participants-indexes" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_participant_conversation_user"/>
            </not>
        </preConditions>
        <!-- One participant row per (conversation, user). -->
        <createIndex indexName="uq_participant_conversation_user"
                     tableName="conversation_participants" unique="true">
            <column name="conversation_id"/>
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_participant_user_id"
                     tableName="conversation_participants">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260607-01-agent-profiles-interaction-mode" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="agent_profiles" columnName="interaction_mode"/>
            </not>
        </preConditions>
        <comment>#7: ONE_SHOT (legacy workflow) vs CONVERSATIONAL (chat sessions).</comment>
        <addColumn tableName="agent_profiles">
            <column name="interaction_mode" type="varchar(20)" defaultValue="ONE_SHOT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
