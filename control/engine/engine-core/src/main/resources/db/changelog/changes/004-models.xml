    <!-- ================================================================
         models
         ================================================================ -->
    <changeSet id="004-models-create-models" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="models"/>
            </not>
        </preConditions>
        <comment>Create models table for AI model configurations</comment>

        <createTable tableName="models">
            <column name="code" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="varchar(50)">
                <constraints nullable="false" foreignKeyName="fk_models_provider" references="model_providers(code)"/>
            </column>
            <column name="model_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="api_endpoint" type="varchar(500)"/>
            <column name="supports_vision" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="infra_config" type="text"/>
            <column name="default_params" type="text"/>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="health_status" type="varchar(20)" defaultValue="UNKNOWN">
                <constraints nullable="false"/>
            </column>
            <column name="last_health_check" type="timestamp with time zone"/>
            <column name="last_tested_at" type="timestamp with time zone"/>
            <column name="last_test_status" type="varchar(20)"/>
            <column name="input_price" type="numeric(10,6)"/>
            <column name="output_price" type="numeric(10,6)"/>
            <column name="currency" type="varchar(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
        </createTable>

        <createIndex indexName="idx_models_status" tableName="models">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_models_provider" tableName="models">
            <column name="provider"/>
        </createIndex>
    </changeSet>

    <!-- Seed GitHub Models GPT-4o for E2E testing and demo -->
    <changeSet id="004-models-seed-github-gpt4o" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM models WHERE code = 'github-gpt-4o'</sqlCheck>
        </preConditions>
        <comment>Seed default GPT-4o model via GitHub Models for E2E testing and demo</comment>

        <insert tableName="models">
            <column name="code" value="github-gpt-4o"/>
            <column name="name" value="GPT-4o (GitHub Models)"/>
            <column name="provider" value="github_models"/>
            <column name="model_id" value="gpt-4o"/>
            <column name="api_endpoint" value="https://models.inference.ai.azure.com"/>
            <column name="supports_vision" valueBoolean="true"/>
            <column name="default_params" value='{"temperature": 0.7}'/>
            <column name="status" value="ACTIVE"/>
            <column name="health_status" value="UNKNOWN"/>
            <column name="input_price" valueNumeric="5.000000"/>
            <column name="output_price" valueNumeric="15.000000"/>
            <column name="currency" value="USD"/>
        </insert>
    </changeSet>

    <!-- ================================================================
         Cross-file FKs: tables created in earlier files (003-agents.xml)
         that reference models(code). Added here (after models table exists)
         so the constraint is valid at creation time.
         ================================================================ -->

    <changeSet id="004-models-add-agent-profiles-model-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_agent_profiles_model"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="agent_profiles"
            baseColumnNames="default_model"
            referencedTableName="models"
            referencedColumnNames="code"
            constraintName="fk_agent_profiles_model"
            onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="004-models-add-agent-hosts-model-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_agent_hosts_model"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="agent_hosts"
            baseColumnNames="model_override"
            referencedTableName="models"
            referencedColumnNames="code"
            constraintName="fk_agent_hosts_model"
            onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>