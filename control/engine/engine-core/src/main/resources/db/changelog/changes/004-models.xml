    <!--
        Squashed changelog: models domain.
        Replaces all incremental changesets for model_providers and models
        with clean createTable definitions reflecting the FINAL table structure.
        All 18 system model providers are seeded as INACTIVE.
        The GitHub Models GPT-4o model is seeded with pricing for E2E/demo use.
    -->

    <!-- ================================================================
         model_providers
         ================================================================ -->
    <changeSet id="004-models-create-model-providers" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="model_providers"/>
            </not>
        </preConditions>
        <comment>Create model_providers table for AI provider configurations</comment>

        <createTable tableName="model_providers">
            <column name="code" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="base_url" type="varchar(500)"/>
            <column name="deployment_type" type="varchar(20)" defaultValue="CLOUD">
                <constraints nullable="false"/>
            </column>
            <column name="requires_auth" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="docs_url" type="varchar(500)"/>
            <column name="description" type="text"/>
            <column name="is_system" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="connection_config_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

