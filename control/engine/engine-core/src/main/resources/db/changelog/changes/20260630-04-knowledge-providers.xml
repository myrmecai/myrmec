<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      AI Context Management — Knowledge Providers (parent + version).
      Two-version model. Config lives in version row, not parent.
      Uses scope + project_id for org/project scoping.
    -->

    <!-- 1. Create parent table -->
    <changeSet id="20260630-04-01-create-knowledge-providers" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="knowledge_providers"/>
            </not>
        </preConditions>
        <comment>Knowledge Providers — parent table. RAG providers (MANAGED/EXTERNAL).</comment>

        <createTable tableName="knowledge_providers">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="scope" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_kp_project"
                             references="projects(id)"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="INCOMPLETE">
                <constraints nullable="false"/>
            </column>
            <column name="current_version_id" type="uuid"/>
            <column name="published_at" type="timestamp with time zone"/>
            <column name="published_by" type="uuid"/>
            <column name="created_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="uuid"/>
        </createTable>
    </changeSet>

    <!-- 2. Unique constraint on (scope, project_id, name) -->
    <changeSet id="20260630-04-02-kp-unique-name" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_kp_scope_project_name"/>
            </not>
        </preConditions>
        <createIndex indexName="uq_kp_scope_project_name"
                     tableName="knowledge_providers" unique="true">
            <column name="scope"/>
            <column name="project_id"/>
            <column name="name"/>
        </createIndex>
    </changeSet>

    <!-- 3. Create version table -->
    <changeSet id="20260630-04-03-create-knowledge-provider-versions" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="knowledge_provider_versions"/>
            </not>
        </preConditions>
        <comment>Knowledge Provider Versions — immutable-once-published config contract.</comment>

        <createTable tableName="knowledge_provider_versions">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="provider_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_kpv_provider"
                             references="knowledge_providers(id)"/>
            </column>
            <column name="version_number" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="parent_version_id" type="uuid"/>
            <column name="status" type="varchar(20)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="connection_config_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_kpv_conn_config"
                             references="connection_configs(id)"/>
            </column>
            <column name="config" type="jsonb"/>
            <column name="draft_owner_id" type="uuid"/>
            <column name="published_at" type="timestamp with time zone"/>
            <column name="published_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 4. FK: current_version_id → knowledge_provider_versions.id -->
    <changeSet id="20260630-04-04-kp-current-version-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_kp_current_version"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="knowledge_providers"
            baseColumnNames="current_version_id"
            referencedTableName="knowledge_provider_versions"
            referencedColumnNames="id"
            constraintName="fk_kp_current_version"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- 5. FK: parent_version_id → knowledge_provider_versions.id (self-reference) -->
    <changeSet id="20260630-04-05-kpv-parent-version-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_kpv_parent_version"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="knowledge_provider_versions"
            baseColumnNames="parent_version_id"
            referencedTableName="knowledge_provider_versions"
            referencedColumnNames="id"
            constraintName="fk_kpv_parent_version"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- 6. Partial unique indexes (PostgreSQL only) -->
    <changeSet id="20260630-04-06-kpv-unique-draft" author="myrmec" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_kpv_draft_per_provider"/>
            </not>
        </preConditions>
        <sql>
            CREATE UNIQUE INDEX uq_kpv_draft_per_provider
            ON knowledge_provider_versions (provider_id) WHERE status = 'DRAFT';
        </sql>
    </changeSet>

    <changeSet id="20260630-04-07-kpv-unique-published" author="myrmec" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_kpv_published_per_provider"/>
            </not>
        </preConditions>
        <sql>
            CREATE UNIQUE INDEX uq_kpv_published_per_provider
            ON knowledge_provider_versions (provider_id) WHERE status = 'PUBLISHED';
        </sql>
    </changeSet>

</databaseChangeLog>