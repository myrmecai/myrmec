<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      AI Context Management — Project Settings.
      Per-project key-value settings. Mirrors system_settings pattern at project scope.
      Seeded with 8 default keys per UC-KM-13, UC-KM-14.
    -->

    <changeSet id="20260630-09-01-create-project-settings" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="project_settings"/>
            </not>
        </preConditions>
        <comment>Project Settings — per-project key-value store mirroring system_settings.</comment>

        <createTable tableName="project_settings">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_ps_project"
                             references="projects(id)"/>
            </column>
            <column name="setting_key" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="value_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="setting_value" type="text"/>
            <column name="description" type="varchar(500)"/>
            <column name="updated_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Unique constraint: (project_id, setting_key) -->
    <changeSet id="20260630-09-02-ps-unique" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_ps_project_key"/>
            </not>
        </preConditions>
        <createIndex indexName="uq_ps_project_key"
                     tableName="project_settings" unique="true">
            <column name="project_id"/>
            <column name="setting_key"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>