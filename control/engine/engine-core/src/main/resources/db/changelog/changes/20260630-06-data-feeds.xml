<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      AI Context Management — Data Feeds (flat model).
      Syncs raw content into a Managed Knowledge Provider using a dataset_name.
      Feeds and sources are defined independently — linked by matching dataset_name.
    -->

    <changeSet id="20260630-06-01-create-data-feeds" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="data_feeds"/>
            </not>
        </preConditions>
        <comment>Data Feeds — flat model. Content syncs into managed knowledge providers.</comment>

        <createTable tableName="data_feeds">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="scope" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_df_project"
                             references="projects(id)"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="provider_version_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_df_provider_version"
                             references="knowledge_provider_versions(id)"/>
            </column>
            <column name="dataset_name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="connection_config_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_df_conn_config"
                             references="connection_configs(id)"/>
            </column>
            <column name="connection_details" type="jsonb"/>
            <column name="sync_schedule" type="varchar(100)"/>
            <column name="sync_status" type="varchar(20)" defaultValue="NEVER">
                <constraints nullable="false"/>
            </column>
            <column name="last_sync_at" type="timestamp with time zone"/>
            <column name="chunk_count" type="integer"/>
            <column name="error_message" type="text"/>
            <column name="created_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="uuid"/>
        </createTable>
    </changeSet>

    <!-- Unique constraint: (scope, project_id, provider_version_id, name) -->
    <changeSet id="20260630-06-02-df-unique-name" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_df_scope_project_provider_name"/>
            </not>
        </preConditions>
        <createIndex indexName="uq_df_scope_project_provider_name"
                     tableName="data_feeds" unique="true">
            <column name="scope"/>
            <column name="project_id"/>
            <column name="provider_version_id"/>
            <column name="name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>