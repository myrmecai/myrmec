<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Phase 10 #71 — rate-limit retry support.

        ``next_eligible_at`` is the wall-clock instant before which the
        dispatcher should NOT pick the task up again. Null = always
        eligible. Set by the rate-limit retry path in
        TaskAttemptService.completeFailed using the agent-supplied
        ``retryAfterSeconds`` (which itself comes from the upstream
        provider's Retry-After header).
    -->

    <changeSet id="20260608-04-01" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="workflow_tasks" columnName="next_eligible_at"/>
            </not>
        </preConditions>
        <addColumn tableName="workflow_tasks">
            <column name="next_eligible_at" type="timestamp with time zone">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260608-04-02" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not><indexExists indexName="idx_workflow_tasks_status_next_eligible"/></not>
        </preConditions>
        <createIndex tableName="workflow_tasks" indexName="idx_workflow_tasks_status_next_eligible">
            <column name="status"/>
            <column name="next_eligible_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
