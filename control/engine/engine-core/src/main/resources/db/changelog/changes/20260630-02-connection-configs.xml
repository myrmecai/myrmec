<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      AI Context Management — Connection Configs (parent + version).
      See UC-018. Uses scope + project_id for org/project scoping.
      Parent row (Zone 1: identity/metadata) + Version row (Zone 2: behaviour contract).
    -->

    <!-- 1. Create parent table -->
    <changeSet id="20260630-02-01-create-connection-configs" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="connection_configs"/>
            </not>
        </preConditions>
        <comment>Connection Configs — parent table. Global connection definitions.</comment>

        <createTable tableName="connection_configs">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="scope" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_conn_config_project"
                             references="projects(id)"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="INCOMPLETE">
                <constraints nullable="false"/>
            </column>
            <column name="credential_secret_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_conn_config_secret"
                             references="secrets(id)"/>
            </column>
            <column name="current_version_id" type="uuid"/>
            <column name="published_at" type="timestamp with time zone"/>
            <column name="published_by" type="uuid"/>
            <column name="created_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="uuid"/>
        </createTable>
    </changeSet>

    <!-- 2. Unique constraint on (scope, project_id, name) -->
    <changeSet id="20260630-02-02-conn-config-unique-name" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_conn_config_scope_project_name"/>
            </not>
        </preConditions>
        <createIndex indexName="uq_conn_config_scope_project_name"
                     tableName="connection_configs" unique="true">
            <column name="scope"/>
            <column name="project_id"/>
            <column name="name"/>
        </createIndex>
    </changeSet>

    <!-- 3. Create version table -->
    <changeSet id="20260630-02-03-create-connection-config-versions" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="connection_config_versions"/>
            </not>
        </preConditions>
        <comment>Connection Config Versions — immutable-once-published behaviour contract.</comment>

        <createTable tableName="connection_config_versions">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="connection_config_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_ccv_conn_config"
                             references="connection_configs(id)"/>
            </column>
            <column name="version_number" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="parent_version_id" type="uuid"/>
            <column name="status" type="varchar(20)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="varchar(2000)"/>
            <column name="config" type="jsonb"/>
            <column name="draft_owner_id" type="uuid"/>
            <column name="published_at" type="timestamp with time zone"/>
            <column name="published_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 4. FK: current_version_id → connection_config_versions.id (self-referencing via parent) -->
    <changeSet id="20260630-02-05-conn-config-current-version-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_conn_config_current_version"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="connection_configs"
            baseColumnNames="current_version_id"
            referencedTableName="connection_config_versions"
            referencedColumnNames="id"
            constraintName="fk_conn_config_current_version"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- 5. FK: parent_version_id → connection_config_versions.id (self-reference) -->
    <changeSet id="20260630-02-06-ccv-parent-version-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_ccv_parent_version"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="connection_config_versions"
            baseColumnNames="parent_version_id"
            referencedTableName="connection_config_versions"
            referencedColumnNames="id"
            constraintName="fk_ccv_parent_version"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- 6. Partial unique indexes: at most one DRAFT and one PUBLISHED per parent (PostgreSQL only) -->
    <changeSet id="20260630-02-07-ccv-unique-draft" author="myrmec" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_ccv_draft_per_config"/>
            </not>
        </preConditions>
        <sql>
            CREATE UNIQUE INDEX uq_ccv_draft_per_config
            ON connection_config_versions (connection_config_id) WHERE status = 'DRAFT';
        </sql>
    </changeSet>

    <changeSet id="20260630-02-08-ccv-unique-published" author="myrmec" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_ccv_published_per_config"/>
            </not>
        </preConditions>
        <sql>
            CREATE UNIQUE INDEX uq_ccv_published_per_config
            ON connection_config_versions (connection_config_id) WHERE status = 'PUBLISHED';
        </sql>
    </changeSet>

</databaseChangeLog>