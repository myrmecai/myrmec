<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      AI Context Management — Context Manifests.
      Per-turn recording of what was included/excluded/truncated in the assembled
      context and why. Written by the Context Builder on every turn.
    -->

    <changeSet id="20260630-11-01-create-context-manifests" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="context_manifests"/>
            </not>
        </preConditions>
        <comment>Context Manifests — per-turn context assembly audit record.</comment>

        <createTable tableName="context_manifests">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="conversation_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_cm_conversation"
                             references="conversations(id)"/>
            </column>
            <column name="message_id" type="uuid"/>
            <column name="sequence_no" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="governance_profile_code" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="context_pinning" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="total_tokens" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="budget_tokens" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="truncated" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="instructions_included" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="instructions_excluded" type="jsonb"/>
            <column name="instructions_truncated" type="jsonb"/>
            <column name="knowledge_retrieved" type="jsonb"/>
            <column name="knowledge_included" type="jsonb"/>
            <column name="knowledge_truncated" type="jsonb"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Index: (conversation_id, sequence_no) — primary query path -->
    <changeSet id="20260630-11-02-cm-index-conversation" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_cm_conversation"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_cm_conversation" tableName="context_manifests">
            <column name="conversation_id"/>
            <column name="sequence_no"/>
        </createIndex>
    </changeSet>

    <!-- Index: message_id — lookup by triggering message -->
    <changeSet id="20260630-11-03-cm-index-message" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_cm_message"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_cm_message" tableName="context_manifests">
            <column name="message_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>