<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      #92 — pin the Assistant + its frozen version onto a conversation
      (assistant-entity.md §3 / §5.6). The design names this table
      `conversation_sessions`; in the live schema the durable session
      container is `conversations` (see UC-014 open item on table naming),
      so the pinning columns land there.

      All three columns are nullable + additive: pre-existing conversations
      (raw lazy agent_id binding) keep working untouched. No FK actions —
      versions are immutable and never cascade-deleted (audit floor).
      `agent_profile_version_id` mirrors the forward seam on assistant_version.
    -->

    <changeSet id="20260621-08-conversation-assistant-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="assistant_id"/>
            </not>
        </preConditions>
        <addColumn tableName="conversations">
            <!-- Durable Assistant identity for this conversation. NULL for legacy/profile-only chats. -->
            <column name="assistant_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_conversation_assistant"
                             references="assistants(id)"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260621-08-conversation-assistant-version-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="assistant_version_id"/>
            </not>
        </preConditions>
        <addColumn tableName="conversations">
            <!-- Pinned immutable behaviour contract. NULL for legacy chats. No FK action: never cascade. -->
            <column name="assistant_version_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_conversation_assistant_version"
                             references="assistant_version(id)"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260621-08-conversation-agent-profile-version-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversations" columnName="agent_profile_version_id"/>
            </not>
        </preConditions>
        <addColumn tableName="conversations">
            <!-- Forward seam: pinned profile version once AgentProfile versioning lands. No FK yet. -->
            <column name="agent_profile_version_id" type="uuid"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
