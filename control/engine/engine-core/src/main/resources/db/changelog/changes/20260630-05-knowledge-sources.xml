<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      AI Context Management — Knowledge Sources (flat model).
      No versioning. Edit applies immediately.
      References the provider version (not parent) so retrieval always uses a pinned config.
      Uses scope + project_id for org/project scoping.
    -->

    <changeSet id="20260630-05-01-create-knowledge-sources" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="knowledge_sources"/>
            </not>
        </preConditions>
        <comment>Knowledge Sources — flat model. Datasets within a provider version.</comment>

        <createTable tableName="knowledge_sources">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="scope" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_ks_project"
                             references="projects(id)"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="provider_version_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_ks_provider_version"
                             references="knowledge_provider_versions(id)"/>
            </column>
            <column name="config" type="jsonb"/>
            <column name="availability" type="varchar(20)" defaultValue="GLOBAL">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="uuid"/>
        </createTable>
    </changeSet>

    <!-- Unique constraint: (scope, project_id, provider_version_id, name) -->
    <changeSet id="20260630-05-02-ks-unique-name" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_ks_scope_project_provider_name"/>
            </not>
        </preConditions>
        <createIndex indexName="uq_ks_scope_project_provider_name"
                     tableName="knowledge_sources" unique="true">
            <column name="scope"/>
            <column name="project_id"/>
            <column name="provider_version_id"/>
            <column name="name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>