<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      AI Context Management — Project Provider Bindings.
      Join table — org providers default INACTIVE at project level (explicit opt-in).
    -->

    <changeSet id="20260630-08-01-create-project-provider-bindings" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="project_provider_bindings"/>
            </not>
        </preConditions>
        <comment>Project Provider Bindings — opt-in join table for org knowledge providers.</comment>

        <createTable tableName="project_provider_bindings">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_ppb_project"
                             references="projects(id)"/>
            </column>
            <column name="provider_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_ppb_provider"
                             references="knowledge_providers(id)"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="INACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Unique constraint: (project_id, provider_id) -->
    <changeSet id="20260630-08-02-ppb-unique" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_ppb_project_provider"/>
            </not>
        </preConditions>
        <createIndex indexName="uq_ppb_project_provider"
                     tableName="project_provider_bindings" unique="true">
            <column name="project_id"/>
            <column name="provider_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>