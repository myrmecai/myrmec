<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Phase 7a — Human-in-the-loop (HITL) approval columns.

        Approval requests reuse ``conversation_messages`` (role =
        ``APPROVAL_REQUEST``); the row's lifecycle is tracked in
        ``approval_status``. ``approval_payload_json`` re-uses the existing
        ``payload_json`` column on the table (no new column needed).
        ``approver_id`` is the *granted* approver; null until the policy
        engine pins one. ``expires_at`` is a hard wall-clock cap — past
        that, the row transitions to EXPIRED on read.

        Phase 7b will start writing the ``risk_class`` column on ``tools``
        and the ``auto_hitl_on_destructive`` policy on ``projects``. The
        columns ship here so the schema is stable before downstream code
        starts populating them.
    -->

    <changeSet id="20260608-01-01" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversation_messages" columnName="approval_status"/>
            </not>
        </preConditions>
        <addColumn tableName="conversation_messages">
            <column name="approval_status" type="varchar(20)">
                <constraints nullable="true"/>
            </column>
            <column name="approver_id" type="uuid">
                <constraints nullable="true"
                             foreignKeyName="fk_conv_messages_approver"
                             references="users(id)"/>
            </column>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260608-01-02" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_conv_messages_approval_status"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_conv_messages_approval_status"
                     tableName="conversation_messages">
            <column name="approval_status"/>
        </createIndex>
    </changeSet>

    <!--
        ``risk_class`` ranks tools so HITL policy can decide whether a
        given invocation needs approval. Values (string, enum-like): SAFE,
        WRITE, DESTRUCTIVE, IRREVERSIBLE. Default SAFE keeps existing
        seeded rows safe-by-default until administrators classify them.
    -->
    <changeSet id="20260608-01-03" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tools" columnName="risk_class"/>
            </not>
        </preConditions>
        <addColumn tableName="tools">
            <column name="risk_class" type="varchar(20)" defaultValue="SAFE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!--
        Per-project policy switch. When true, the dispatcher MUST require
        an approval response before executing any tool whose risk_class is
        DESTRUCTIVE or IRREVERSIBLE. Default false preserves Phase 6
        behaviour for upgraded installs.
    -->
    <changeSet id="20260608-01-04" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="projects" columnName="auto_hitl_on_destructive"/>
            </not>
        </preConditions>
        <addColumn tableName="projects">
            <column name="auto_hitl_on_destructive" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
