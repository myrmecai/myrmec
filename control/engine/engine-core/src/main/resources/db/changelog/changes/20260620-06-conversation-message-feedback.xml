<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Response feedback on assistant messages (#104a).

        Adds a thumbs-up / thumbs-down rating plus an optional free-text
        reason to ``conversation_messages``, stored directly on the rated
        row. Attributable (``feedback_by`` = the rating user) and stamped
        (``feedback_at``). All four columns are nullable: an un-rated
        message simply has no feedback. Only ASSISTANT rows are rateable
        (enforced in the service), but the columns are added without a
        check constraint so a future re-classification is non-breaking.
    -->
    <changeSet id="20260620-06-01" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="conversation_messages" columnName="feedback_rating"/>
            </not>
        </preConditions>
        <addColumn tableName="conversation_messages">
            <column name="feedback_rating" type="varchar(10)"/>
            <column name="feedback_reason" type="text"/>
            <column name="feedback_by" type="uuid"/>
            <column name="feedback_at" type="timestamp with time zone"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
