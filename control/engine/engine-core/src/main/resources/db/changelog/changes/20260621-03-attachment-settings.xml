<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Attachment limits (#103). Added as standalone idempotent inserts (guarded
      per-key) so they land on existing installs whose system_settings seed has
      already run. Consumed by the attachment upload pipeline.
    -->
    <changeSet id="20260621-03-attachment-max-file-size" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="system_settings"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM system_settings WHERE setting_key = 'attachment_max_file_size_bytes'
            </sqlCheck>
        </preConditions>
        <insert tableName="system_settings">
            <column name="setting_key" value="attachment_max_file_size_bytes"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="10485760"/>
            <column name="description" value="Maximum size (bytes) of a single uploaded attachment; larger uploads are rejected. Default 10 MiB."/>
        </insert>
    </changeSet>

    <changeSet id="20260621-03-attachment-inline-token-limit" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="system_settings"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM system_settings WHERE setting_key = 'attachment_inline_token_limit'
            </sqlCheck>
        </preConditions>
        <insert tableName="system_settings">
            <column name="setting_key" value="attachment_inline_token_limit"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="4000"/>
            <column name="description" value="Max tokens of extracted attachment text injected inline into a turn before falling back to the read_attachment tool. Default 4000."/>
        </insert>
    </changeSet>

</databaseChangeLog>
