<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Authorization codes for the desktop-client login flow (VS Code
        plugin): the hosted login page calls authorize-code with the
        logged-in JWT; the plugin redeems the one-time code on any
        engine replica via code/exchange. Codes are stored hashed, are
        single-use (portable compare-and-swap UPDATE), and expire after
        a short TTL. code_challenge/challenge_method are reserved for
        the future PKCE upgrade (filled in, never migrated).
    -->

    <!-- ================================================================
         auth_codes
         ================================================================ -->
    <changeSet id="015-auth-codes-create-auth-codes" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="auth_codes"/>
            </not>
        </preConditions>

        <createTable tableName="auth_codes">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code_hash" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="redirect_uri" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="code_challenge" type="varchar(128)"/>
            <column name="challenge_method" type="varchar(16)"/>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="timestamp with time zone"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="auth_codes"
            baseColumnNames="user_id"
            constraintName="fk_auth_codes_user"
            referencedTableName="users"
            referencedColumnNames="id"/>

        <createIndex indexName="idx_auth_codes_expires_at" tableName="auth_codes">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>