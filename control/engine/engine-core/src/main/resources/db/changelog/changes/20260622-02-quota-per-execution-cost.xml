<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Phase 8c/8g - Per-execution cost ceiling (#40).

      Hard cap on a single workflow run or session turn, independent of
      the periodic quota. Used to prevent runaway costs in a single
      invocation. Null means no per-execution cap.

      Renamed to `max_execution_amount` so it can be used with any
      resource type (not only cost). The legacy `max_execution_cost_cents`
      column is retained for backward compatibility but deprecated.
    -->

    <changeSet id="20260622-02-quota-per-execution-cost" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="quotas" columnName="max_execution_amount"/>
            </not>
        </preConditions>
        <addColumn tableName="quotas">
            <column name="max_execution_amount" type="bigint"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
