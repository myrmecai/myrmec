<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Local-owner model (§3.7/§4.1): agent_hosts.owner_user_id is dropped.
        Changelog 030 deliberately kept the column as the per-user LOCAL-host
        identity key (uk_agent_hosts_type_owner +
        findByHostTypeAndOwnerUserId in local registration §4.1). Ownership
        now rides agent_host_instances.owner_user_id alone: the host row is a
        per-user placeholder and the VS Code plugin declares its user in the
        host.open payload (ownerUserId), so the host column has no reader.
        Dev phase — no data migration.
    -->

    <changeSet id="031-host-owner-index-drop" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="agent_hosts" indexName="uk_agent_hosts_type_owner"/>
        </preConditions>
        <dropIndex tableName="agent_hosts" indexName="uk_agent_hosts_type_owner"/>
    </changeSet>

    <changeSet id="031-host-owner-column-drop" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="agent_hosts" columnName="owner_user_id"/>
        </preConditions>
        <dropColumn tableName="agent_hosts" columnName="owner_user_id"/>
    </changeSet>

</databaseChangeLog>