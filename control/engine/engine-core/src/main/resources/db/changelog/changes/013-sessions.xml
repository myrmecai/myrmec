<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Squashed changelog: sessions table.
        A session binds a service interaction (conversation, workflow run, etc.)
        to a team and carries context pins for the active context builder.

    This changelog consolidates the unified-protocol session columns
    (kind, host_instance_id, allocation_state, offer/idle leases) that
    were previously added incrementally in 018-agent-host-instances.xml.
    -->

    <!-- ================================================================
     sessions
     ================================================================ -->
    <changeSet id="013-sessions-create-sessions" author="myrmec">
    <preConditions onFail="MARK_RAN">
        <not>
            <tableExists tableName="sessions"/>
        </not>
    </preConditions>

    <createTable tableName="sessions">
        <column name="id" type="uuid">
            <constraints primaryKey="true" nullable="false"/>
        </column>
        <column name="service_type" type="varchar(20)">
            <constraints nullable="false"/>
        </column>
        <column name="ref_id" type="uuid">
            <constraints nullable="false"/>
        </column>
        <column name="team_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        <column name="context_pins" type="jsonb"/>
        <column name="status" type="varchar(20)" defaultValue="ACTIVE">
            <constraints nullable="false"/>
        </column>
        <!-- Protocol §3.1 session kind: CONVERSATION | ORCHESTRATION_TASK. -->
        <column name="kind" type="varchar(20)"/>
        <!-- The agent_host_instances row serving this session (FK SET NULL). -->
        <column name="host_instance_id" type="uuid"/>
        <!-- Protocol §11.1 allocation FSM: OFFERED|INITIALIZING|ACTIVE|CLOSING|CLOSED|RECOVERING. -->
        <column name="allocation_state" type="varchar(20)"/>
        <!-- Pending-offer lease expiry (§7.1). -->
        <column name="offer_expires_at" type="timestamp with time zone"/>
        <!-- Conversation idle-lease expiry (§12.2). -->
        <column name="idle_lease_expires_at" type="timestamp with time zone"/>
        <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
            <constraints nullable="false"/>
        </column>
        <column name="closed_at" type="timestamp with time zone"/>
    </createTable>

    <addForeignKeyConstraint
        baseTableName="sessions"
        baseColumnNames="team_id"
        constraintName="fk_sessions_team"
        referencedTableName="teams"
        referencedColumnNames="id"/>

    <addForeignKeyConstraint
        baseTableName="sessions"
        baseColumnNames="host_instance_id"
        referencedTableName="agent_host_instances"
        referencedColumnNames="id"
        constraintName="fk_sessions_host_instance"
        onDelete="SET NULL"/>

    <createIndex indexName="idx_sessions_ref_id" tableName="sessions">
        <column name="ref_id"/>
    </createIndex>

    <createIndex indexName="idx_sessions_host_instance" tableName="sessions">
        <column name="host_instance_id"/>
    </createIndex>

    <createIndex indexName="idx_sessions_allocation_state" tableName="sessions">
        <column name="allocation_state"/>
    </createIndex>

    <createIndex indexName="idx_sessions_allocation_expiry" tableName="sessions">
        <column name="allocation_state"/>
        <column name="offer_expires_at"/>
    </createIndex>
    </changeSet>

</databaseChangeLog>