    </changeSet>

    <!-- ================================================================
         Cross-file FKs: tables created in earlier files (003-agents.xml)
         that reference tools(code). Added here (after tools table exists)
         so the constraint is valid at creation time.
         ================================================================ -->

    <changeSet id="005-tools-add-agent-profile-tools-tool-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_agent_profile_tools_tool"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="agent_profile_tools"
            baseColumnNames="tool_code"
            referencedTableName="tools"
            referencedColumnNames="code"
            constraintName="fk_agent_profile_tools_tool"
            onDelete="CASCADE"/>
    </changeSet>

    <!-- ================================================================
         Fix stale risk_class values from the pre-squash schema.
         The old incremental changelog used 'MEDIUM' as the column
         default, but the RiskClass enum only defines SAFE, WRITE,
         DESTRUCTIVE, IRREVERSIBLE. Update any MEDIUM rows to SAFE
         (the documented default for seeded tools).
         ================================================================ -->
    <changeSet id="005-tools-fix-risk-class-medium" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tools"/>
        </preConditions>
        <update tableName="tools">
            <column name="risk_class" value="SAFE"/>
            <where>risk_class = 'MEDIUM'</where>
        </update>
    </changeSet>

</databaseChangeLog>