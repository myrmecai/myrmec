<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ================================================================
         tools
         ================================================================ -->
    <changeSet id="005-tools-create-tools" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tools"/>
            </not>
        </preConditions>

        <createTable tableName="tools">
            <column name="code" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="tool_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="config_schema" type="text"/>
            <column name="docs_url" type="varchar(500)"/>
            <column name="is_system" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="risk_class" type="varchar(20)" defaultValue="SAFE">
                <constraints nullable="false"/>
            </column>
            <column name="description_hash" type="varchar(64)"/>
            <column name="description_approved_at" type="timestamp with time zone"/>
            <column name="description_approved_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_tools_status" tableName="tools">
            <column name="status"/>
        </createIndex>
    </changeSet>



    <!-- ================================================================
         Cross-file FKs: tables created in earlier files (003-agents.xml)
         that reference tools(code). Added here (after tools table exists)
         so the constraint is valid at creation time.
         ================================================================ -->

    <changeSet id="005-tools-add-agent-profile-tools-tool-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_agent_profile_tools_tool"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="agent_profile_tools"
            baseColumnNames="tool_code"
            referencedTableName="tools"
            referencedColumnNames="code"
            constraintName="fk_agent_profile_tools_tool"
            onDelete="CASCADE"/>
    </changeSet>

    <!-- ================================================================
         Fix stale risk_class values from the pre-squash schema.
         The old incremental changelog used 'MEDIUM' as the column
         default, but the RiskClass enum only defines SAFE, WRITE,
         DESTRUCTIVE, IRREVERSIBLE. Update any MEDIUM rows to SAFE
         (the documented default for seeded tools).
         ================================================================ -->
    <changeSet id="005-tools-fix-risk-class-medium" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tools"/>
        </preConditions>
        <update tableName="tools">
            <column name="risk_class" value="SAFE"/>
            <where>risk_class = 'MEDIUM'</where>
        </update>
    </changeSet>

</databaseChangeLog>