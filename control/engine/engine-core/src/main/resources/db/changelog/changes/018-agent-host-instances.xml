<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Unified agent protocol (2026-09-12 §4.1/§19.1; design 2026-09-11 §2.5):
        agent_host_instances is the append-only runtime layer — one row per
        supervisor process run. OPEN rows carry live_key='OPEN' so the
        portable unique index (agent_host_id, owner_user_id, live_key)
        enforces one live instance per owner while NULL (closed) rows never
        collide and history is retained. CLOSED is terminal; no row is ever
        reopened or reused.
    -->

    <changeSet id="018-create-agent-host-instances" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="agent_host_instances"/>
            </not>
        </preConditions>

        <createTable tableName="agent_host_instances">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="agent_host_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <!-- LOCAL/DEDICATED only; NULL for MANAGED (§2.3) -->
            <column name="owner_user_id" type="uuid"/>
            <column name="hostname" type="varchar(255)"/>
            <column name="pool_size" type="integer" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="reported_capacity" type="text"/>
            <column name="control_node_id" type="varchar(255)"/>
            <column name="status" type="varchar(20)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
            <!-- 'OPEN' while live, NULL once closed — portable partial
                 uniqueness without a filtered index (R4/R11). -->
            <column name="live_key" type="varchar(8)"/>
            <column name="opened_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_heartbeat_at" type="timestamp with time zone"/>
            <column name="closed_at" type="timestamp with time zone"/>
            <column name="close_reason" type="varchar(100)"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="agent_host_instances"
            baseColumnNames="agent_host_id"
            referencedTableName="agent_hosts"
            referencedColumnNames="id"
            constraintName="fk_agent_host_instances_host"
            onDelete="CASCADE"/>

        <createIndex indexName="idx_agent_host_instances_host_status" tableName="agent_host_instances">
            <column name="agent_host_id"/>
            <column name="status"/>
        </createIndex>

        <!-- Portable one-live-per-owner: NULL live_key (closed rows) and NULL
             owner (MANAGED) never collide under NULL-distinct semantics. -->
        <createIndex indexName="uk_agent_host_instances_live" tableName="agent_host_instances" unique="true">
            <column name="agent_host_id"/>
            <column name="owner_user_id"/>
            <column name="live_key"/>
        </createIndex>

        <createIndex indexName="idx_agent_host_instances_host_opened" tableName="agent_host_instances">
            <column name="agent_host_id"/>
            <column name="opened_at"/>
        </createIndex>

        <createIndex indexName="idx_agent_host_instances_control_node" tableName="agent_host_instances">
            <column name="control_node_id"/>
        </createIndex>
    </changeSet>

    <!--
        agent_hosts rework (design §2.3/§2.4): host_type replaces the is_local
        boolean; local_user_id renames to owner_user_id; local hosts become
        per-USER (unique host_type+owner) instead of per-(user, project);
        profile_id becomes nullable (profiles bind at session time, §19.1).
        Order is load-bearing (R4): add nullable → backfill → NOT NULL → only
        then drop is_local and the 016 index.
    -->

    <changeSet id="018-agent-hosts-host-type" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="agent_hosts" columnName="is_local"/>
                <not>
                    <columnExists tableName="agent_hosts" columnName="host_type"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="agent_hosts">
            <column name="host_type" type="varchar(20)">
                <!-- Nullable at first: backfill below, NOT NULL after (R4). -->
            </column>
        </addColumn>

        <sql>UPDATE agent_hosts SET host_type = CASE WHEN is_local THEN 'LOCAL' ELSE 'MANAGED' END</sql>

        <addNotNullConstraint
            tableName="agent_hosts"
            columnName="host_type"
            columnDataType="varchar(20)"
            constraintName="nn_agent_hosts_host_type"/>
    </changeSet>

    <changeSet id="018-agent-hosts-owner-rename" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="agent_hosts" columnName="local_user_id"/>
                <not>
                    <columnExists tableName="agent_hosts" columnName="owner_user_id"/>
                </not>
            </and>
        </preConditions>

        <renameColumn
            tableName="agent_hosts"
            oldColumnName="local_user_id"
            newColumnName="owner_user_id"
            columnDataType="uuid"/>
    </changeSet>

    <changeSet id="018-agent-hosts-drop-is-local" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="agent_hosts" columnName="is_local"/>
        </preConditions>

        <dropIndex
            tableName="agent_hosts"
            indexName="idx_agent_hosts_local_user_project"/>

        <dropColumn tableName="agent_hosts" columnName="is_local"/>
    </changeSet>

    <changeSet id="018-agent-hosts-owner-unique" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="agent_hosts" columnName="host_type"/>
                <columnExists tableName="agent_hosts" columnName="owner_user_id"/>
                <not>
                    <indexExists tableName="agent_hosts" indexName="uk_agent_hosts_type_owner"/>
                </not>
            </and>
        </preConditions>

        <!-- One LOCAL/DEDICATED host per owner; MANAGED rows carry a NULL
             owner and never collide under NULL-distinct semantics. -->
        <createIndex indexName="uk_agent_hosts_type_owner" tableName="agent_hosts" unique="true">
            <column name="host_type"/>
            <column name="owner_user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="018-agent-hosts-profile-nullable" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="agent_hosts" columnName="profile_id"/>
            </and>
        </preConditions>

        <!-- H2 requires columnDataType on dropNotNullConstraint (R4). -->
        <dropNotNullConstraint
            tableName="agent_hosts"
            columnName="profile_id"
            columnDataType="uuid"/>
    </changeSet>

</databaseChangeLog>
