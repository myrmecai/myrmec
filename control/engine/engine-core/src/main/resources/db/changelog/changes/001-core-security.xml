<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Squashed changelog: core security tables.
        Replaces all incremental changesets for users, user_roles,
        registration_keys, groups, service_accounts, system_settings,
        and authentication_providers with clean createTable definitions
        reflecting the FINAL table structure.
    -->

    <!-- ================================================================
         authentication_providers
         ================================================================ -->
    <changeSet id="001-core-security-create-authentication-providers" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="authentication_providers"/>
            </not>
        </preConditions>

        <createTable tableName="authentication_providers">
            <column name="code" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="provider_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="is_enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_system" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="metadata" type="text" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="authentication_providers">
            <column name="code" value="LOCAL"/>
            <column name="provider_type" value="LOCAL"/>
            <column name="name" value="Local Account"/>
            <column name="is_enabled" valueBoolean="true"/>
            <column name="is_system" valueBoolean="true"/>
            <column name="metadata" value="{}"/>
        </insert>

        <insert tableName="authentication_providers">
            <column name="code" value="OIDC_DEFAULT"/>
            <column name="provider_type" value="OIDC"/>
            <column name="name" value="OIDC (Default)"/>
            <column name="is_enabled" valueBoolean="false"/>
            <column name="is_system" valueBoolean="true"/>
            <column name="metadata" value="{}"/>
        </insert>

        <insert tableName="authentication_providers">
            <column name="code" value="GITHUB_DEFAULT"/>
            <column name="provider_type" value="GITHUB"/>
            <column name="name" value="GitHub (Default)"/>
            <column name="is_enabled" valueBoolean="false"/>
            <column name="is_system" valueBoolean="true"/>
            <column name="metadata" value="{}"/>
        </insert>

        <insert tableName="authentication_providers">
            <column name="code" value="GOOGLE_DEFAULT"/>
            <column name="provider_type" value="GOOGLE"/>
            <column name="name" value="Google (Default)"/>
            <column name="is_enabled" valueBoolean="false"/>
            <column name="is_system" valueBoolean="true"/>
            <column name="metadata" value="{}"/>
        </insert>

        <createIndex indexName="idx_authentication_providers_type" tableName="authentication_providers">
            <column name="provider_type"/>
        </createIndex>

        <createIndex indexName="idx_authentication_providers_enabled" tableName="authentication_providers">
            <column name="is_enabled"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================
         users
         ================================================================ -->
    <changeSet id="001-core-security-create-users" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users"/>
            </not>
        </preConditions>

        <createTable tableName="users">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="varchar(100)"/>
            <column name="provider_code" type="varchar(50)" defaultValue="LOCAL">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="is_system" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="users"
            baseColumnNames="provider_code"
            constraintName="fk_users_auth_provider"
            referencedTableName="authentication_providers"
            referencedColumnNames="code"/>

        <sql>
            ALTER TABLE users
            ADD CONSTRAINT ck_users_provider_code
            CHECK (provider_code IS NOT NULL);
        </sql>

        <sql>
            ALTER TABLE users
            ADD CONSTRAINT ck_users_system_local_provider
            CHECK (is_system = false OR provider_code = 'LOCAL');
        </sql>

        <createIndex indexName="idx_users_email" tableName="users">
            <column name="email"/>
        </createIndex>

        <createIndex indexName="idx_users_provider_code" tableName="users">
            <column name="provider_code"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================
         registration_keys
         ================================================================ -->
    <changeSet id="001-core-security-create-registration-keys" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="registration_keys"/>
            </not>
        </preConditions>

        <createTable tableName="registration_keys">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key_hash" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="label" type="varchar(100)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="expires_at" type="timestamp"/>
            <column name="is_revoked" type="boolean" defaultValueBoolean="false"/>
        </createTable>

        <createIndex indexName="idx_registration_keys_key_hash" tableName="registration_keys">
            <column name="key_hash"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================
         groups
         ================================================================ -->
    <changeSet id="001-core-security-create-groups" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="groups"/>
            </not>
        </preConditions>

        <createTable tableName="groups">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_groups_name"/>
            </column>
            <column name="parent_group_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="text"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="groups"
            baseColumnNames="parent_group_id"
            constraintName="fk_groups_parent_group"
            referencedTableName="groups"
            referencedColumnNames="id"
            onDelete="RESTRICT"/>

        <createIndex indexName="idx_groups_parent_group_id" tableName="groups">
            <column name="parent_group_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-core-security-seed-default-group" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM groups WHERE id = '00000000-0000-0000-0000-000000000001'
            </sqlCheck>
        </preConditions>

        <insert tableName="groups">
            <column name="id" value="00000000-0000-0000-0000-000000000001"/>
            <column name="name" value="Default"/>
            <column name="description" value="Default group for projects without explicit group assignment."/>
        </insert>
    </changeSet>

    <!-- ================================================================
         user_roles
         ================================================================ -->
    <changeSet id="001-core-security-create-user-roles" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_roles"/>
            </not>
        </preConditions>

        <createTable tableName="user_roles">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="scope_type" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="group_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="granted_by_user_id" type="uuid">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="user_roles"
            baseColumnNames="user_id"
            constraintName="fk_user_roles_user"
            referencedTableName="users"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="user_roles"
            baseColumnNames="granted_by_user_id"
            constraintName="fk_user_roles_granted_by"
            referencedTableName="users"
            referencedColumnNames="id"
            onDelete="SET NULL"/>

        <addForeignKeyConstraint
            baseTableName="user_roles"
            baseColumnNames="group_id"
            constraintName="fk_user_roles_group"
            referencedTableName="groups"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <sql>
            ALTER TABLE user_roles
            ADD CONSTRAINT ck_user_roles_scope CHECK (
                (scope_type = 'SYSTEM'  AND group_id IS NULL     AND project_id IS NULL)
             OR (scope_type = 'GROUP'   AND group_id IS NOT NULL AND project_id IS NULL)
             OR (scope_type = 'PROJECT' AND group_id IS NULL     AND project_id IS NOT NULL)
            )
        </sql>

        <createIndex indexName="idx_user_roles_user_id" tableName="user_roles">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_user_roles_project_id" tableName="user_roles">
            <column name="project_id"/>
        </createIndex>

        <createIndex indexName="idx_user_roles_group_id" tableName="user_roles">
            <column name="group_id"/>
        </createIndex>
    </changeSet>

    <!-- Per-scope partial unique indexes (PostgreSQL only) -->
    <changeSet id="001-core-security-user-roles-scope-indexes-pg" author="myrmec" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_user_roles_system"/>
            </not>
        </preConditions>
        <sql>
            CREATE UNIQUE INDEX uq_user_roles_system
                ON user_roles (user_id, role)
                WHERE scope_type = 'SYSTEM'
        </sql>
        <sql>
            CREATE UNIQUE INDEX uq_user_roles_group
                ON user_roles (user_id, role, group_id)
                WHERE scope_type = 'GROUP'
        </sql>
        <sql>
            CREATE UNIQUE INDEX uq_user_roles_project
                ON user_roles (user_id, role, project_id)
                WHERE scope_type = 'PROJECT'
        </sql>
    </changeSet>

    <!-- ================================================================
         service_accounts
         ================================================================ -->
    <changeSet id="001-core-security-create-service-accounts" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="service_accounts"/>
            </not>
        </preConditions>

        <createTable tableName="service_accounts">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="keycloak_client_id" type="varchar(255)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_service_account_keycloak_client_id"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="rate_limit_per_min" type="int" defaultValueNumeric="60">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_service_account_created_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_service_account_project" tableName="service_accounts">
            <column name="project_id"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================
         system_settings
         ================================================================ -->
    <changeSet id="001-core-security-create-system-settings" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="system_settings"/>
            </not>
        </preConditions>

        <createTable tableName="system_settings">
            <column name="setting_key" type="varchar(120)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="value_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="setting_value" type="clob"/>
            <column name="description" type="varchar(500)"/>
            <column name="updated_by" type="uuid"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- System settings seed is consolidated in 014-seed-data.xml.
         This changeSet is kept for Liquibase checksum stability but made
         idempotent by checking for any existing row. -->
    <changeSet id="001-core-security-system-settings-seed" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="system_settings"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM system_settings WHERE setting_key = 'history_limit'</sqlCheck>
        </preConditions>

        <insert tableName="system_settings">
            <column name="setting_key" value="history_limit"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="20"/>
            <column name="description" value="Sliding-window size: most-recent messages sent verbatim to the model each turn."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="bind_wait_timeout_seconds"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="30"/>
            <column name="description" value="How long a PENDING conversation waits for agent capacity before failing with BIND_TIMEOUT_NO_CAPACITY."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="turn_timeout_seconds"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="120"/>
            <column name="description" value="Hard cap on a single turn's generation before TURN_FAILED (timeout)."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="summary_trigger_ratio"/>
            <column name="value_type" value="RATIO"/>
            <column name="setting_value" value="0.75"/>
            <column name="description" value="Fold the tail of the conversation into a CONTEXT_SUMMARY when context usage crosses this fraction of the model window."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="max_pinned"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="20"/>
            <column name="description" value="Maximum pinned messages per conversation; further pins are rejected."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="summarizer_model_code"/>
            <column name="value_type" value="MODEL_REF"/>
            <column name="setting_value" value=""/>
            <column name="description" value="Utility model code for context summaries and conversation auto-titles. Empty = fall back to the session model."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="host_heartbeat_interval_seconds"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="10"/>
            <column name="description" value="Interval at which an Agent Host supervisor emits heartbeats to the engine."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="host_heartbeat_soft_grace_seconds"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="30"/>
            <column name="description" value="Heartbeat soft grace before ONLINE -> DEGRADED (HEARTBEAT_LATE)."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="host_heartbeat_hard_threshold_seconds"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="90"/>
            <column name="description" value="Heartbeat hard threshold before DEGRADED -> OFFLINE (HEARTBEAT_LOST)."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="host_drain_deadline_seconds"/>
            <column name="value_type" value="INT"/>
            <column name="setting_value" value="300"/>
            <column name="description" value="Drain deadline before DRAINING -> OFFLINE forces a soft release (DRAIN_TIMEOUT)."/>
        </insert>
        <insert tableName="system_settings">
            <column name="setting_key" value="secret_leak_mode"/>
            <column name="value_type" value="STRING"/>
            <column name="setting_value" value="REDACT"/>
            <column name="description" value="Secret leak enforcement mode: BLOCK, REDACT, or WARN."/>
        </insert>
    </changeSet>

</databaseChangeLog>