<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      #25a event-driven (push) source re-sync. A signed inbound webhook marks a
      knowledge source "due" by stamping sync_requested_at; KnowledgeSyncScheduler
      picks it up on its next tick and clears the stamp. Additive + nullable so
      existing rows and schedule-only sources are unaffected.
    -->
    <changeSet id="20260622-01-knowledge-sources-sync-requested-at" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="knowledge_sources"/>
                <not>
                    <columnExists tableName="knowledge_sources" columnName="sync_requested_at"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="knowledge_sources">
            <column name="sync_requested_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260622-01-knowledge-sources-sync-requested-index" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_knowledge_source_sync_requested"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_knowledge_source_sync_requested" tableName="knowledge_sources">
            <column name="sync_requested_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
