<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      #92 companion columns on pre-existing tables (assistant-entity.md
      §4.2 / §4.4 / §4.5). All additive with safe defaults so existing rows
      are unaffected.
    -->

    <!-- §4.2 — profile can forbid Assistant addenda. -->
    <changeSet id="20260621-07-agent-profile-addendum-allowed" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="agent_profiles" columnName="addendum_allowed"/>
            </not>
        </preConditions>
        <addColumn tableName="agent_profiles">
            <column name="addendum_allowed" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- §4.5 — a profile tool can be made mandatory (assistants cannot disable it). -->
    <changeSet id="20260621-07-agent-profile-tools-disable-allowed" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="agent_profile_tools"/>
                <not>
                    <columnExists tableName="agent_profile_tools" columnName="assistant_disable_allowed"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="agent_profile_tools">
            <column name="assistant_disable_allowed" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- §4.4 — knowledge_bases gains assistant-binding governance columns. -->
    <changeSet id="20260621-07-knowledge-bases-embedding-model" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="knowledge_bases" columnName="embedding_model"/>
            </not>
        </preConditions>
        <addColumn tableName="knowledge_bases">
            <column name="embedding_model" type="varchar(80)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260621-07-knowledge-bases-status" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="knowledge_bases" columnName="status"/>
            </not>
        </preConditions>
        <!-- ACTIVE / SYNCING / DISABLED / ARCHIVED -->
        <addColumn tableName="knowledge_bases">
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260621-07-knowledge-bases-classification" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="knowledge_bases" columnName="classification"/>
            </not>
        </preConditions>
        <addColumn tableName="knowledge_bases">
            <column name="classification" type="varchar(40)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260621-07-knowledge-bases-allow-assistant-binding" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="knowledge_bases" columnName="allow_assistant_binding"/>
            </not>
        </preConditions>
        <addColumn tableName="knowledge_bases">
            <column name="allow_assistant_binding" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
