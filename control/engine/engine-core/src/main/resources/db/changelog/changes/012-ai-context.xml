    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Squashed changelog: AI Context / Knowledge domain.
        Replaces all incremental changesets for connection_configs,
        connection_config_versions, instruction_assets,
        instruction_asset_versions, knowledge_providers,
        knowledge_provider_versions, knowledge_sources,
        knowledge_chunks, data_feeds, context_manifests,
        assistants, assistant_version, assistant_grants,
        and assistant_context_bindings with clean createTable
        definitions reflecting the FINAL table structure.
    -->

    <!-- ================================================================
         connection_configs
         ================================================================ -->
    <changeSet id="012-ai-context-create-connection-configs" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="connection_configs"/>
            </not>
        </preConditions>

        <createTable tableName="connection_configs">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="scope" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="INCOMPLETE">
                <constraints nullable="false"/>
            </column>
            <column name="credential_secret_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="current_version_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="published_at" type="timestamp with time zone"/>
            <column name="published_by" type="uuid"/>
            <column name="created_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="uuid"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="connection_configs"
            baseColumnNames="project_id"
            constraintName="fk_conn_config_project"
            referencedTableName="projects"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="connection_configs"
            baseColumnNames="credential_secret_id"
            constraintName="fk_conn_config_credential_secret"
            referencedTableName="secrets"
            referencedColumnNames="id"
            onDelete="SET NULL"/>

        <createIndex indexName="uq_conn_config_scope_project_name" tableName="connection_configs" unique="true">
            <column name="scope"/>
            <column name="project_id"/>
            <column name="name"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================
         connection_config_versions
         ================================================================ -->
    <changeSet id="012-ai-context-create-connection-config-versions" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="connection_config_versions"/>
            </not>
        </preConditions>

        <createTable tableName="connection_config_versions">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="connection_config_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="version_number" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="parent_version_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="varchar(2000)"/>
            <column name="config" type="jsonb"/>
            <column name="test_status" type="varchar(20)"/>
            <column name="last_test_at" type="timestamp with time zone"/>
            <column name="last_test_error" type="text"/>
            <column name="draft_owner_id" type="uuid"/>
            <column name="published_at" type="timestamp with time zone"/>
            <column name="published_by" type="uuid"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="connection_config_versions"
            baseColumnNames="connection_config_id"
            constraintName="fk_conn_config_version_config"
            referencedTableName="connection_configs"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="connection_config_versions"
            baseColumnNames="parent_version_id"
            constraintName="fk_conn_config_version_parent"
            referencedTableName="connection_config_versions"
            referencedColumnNames="id"
            onDelete="SET NULL"/>

        <addForeignKeyConstraint
            baseTableName="connection_configs"
            baseColumnNames="current_version_id"
            constraintName="fk_conn_config_current_version"
            referencedTableName="connection_config_versions"
            referencedColumnNames="id"
            onDelete="SET NULL"/>

        <sql dbms="postgresql">
            CREATE UNIQUE INDEX uq_conn_config_version_draft
            ON connection_config_versions (connection_config_id)
            WHERE status = 'DRAFT';
        </sql>

        <sql dbms="postgresql">
            CREATE UNIQUE INDEX uq_conn_config_version_published
            ON connection_config_versions (connection_config_id)
            WHERE status = 'PUBLISHED';
        </sql>
    </changeSet>

