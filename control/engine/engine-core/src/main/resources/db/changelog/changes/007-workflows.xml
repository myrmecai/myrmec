    <!-- Index for querying attempts by task -->
    <changeSet id="007-workflows-attempts-idx-task-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="task_attempts"/>
            <not><indexExists indexName="idx_task_attempts_task_id"/></not>
