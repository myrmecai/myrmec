    <!-- FK for current_attempt_id (moved here from before task_attempts creation
         to avoid "Table TASK_ATTEMPTS not found" since it references task_attempts(id)) -->
    <changeSet id="007-workflows-tasks-fk-current-attempt" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <tableExists tableName="task_attempts"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_workflow_tasks_current_attempt"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="workflow_tasks"
            baseColumnNames="current_attempt_id"
            referencedTableName="task_attempts"
            referencedColumnNames="id"
            constraintName="fk_workflow_tasks_current_attempt"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- ================================================================== -->
    <!-- EXECUTION_SNAPSHOTS                                                -->
    <!-- ================================================================== -->

    <changeSet id="007-workflows-create-execution-snapshots" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="execution_snapshots"/>
            </not>
        </preConditions>
        <createTable tableName="execution_snapshots">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="agent_id" type="uuid"/>
            <column name="conversation_id" type="uuid"/>
            <column name="message_id" type="uuid"/>
            <column name="workflow_id" type="uuid"/>
            <column name="step_run_id" type="uuid"/>
            <column name="event_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="varchar(20)"/>
            <column name="service_account_id" type="uuid"/>
            <column name="external_user_ref" type="varchar(255)"/>
            <column name="user_id" type="uuid"/>
            <column name="payload_json" type="clob"/>
            <column name="payload_uri" type="varchar(500)"/>
            <column name="payload_sha256" type="varchar(64)"/>
            <column name="size_bytes" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="truncated" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="sampled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- FK to projects -->
