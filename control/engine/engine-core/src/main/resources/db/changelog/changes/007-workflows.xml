    <!-- ================================================================
         ORCHESTRATION (design §16.7 — Feature 10)                          -->
    <!-- ================================================================ -->

    <!-- workflows: orchestration Profile alias bindings (design §16.1).
         Publication requires an explicit map from the workflow-local
         agentProfileCode alias to an existing Agent Profile UUID. -->
    <changeSet id="007-workflows-orchestration-bindings" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflows"/>
            <not><columnExists tableName="workflows" columnName="orchestration_bindings"/></not>
        </preConditions>
        <addColumn tableName="workflows">
            <column name="orchestration_bindings" type="text"/>
        </addColumn>
    </changeSet>

    <!--
      orchestration_runs: one durable owner row per orchestration workflow
      request. id == the workflow request UUID (the run). Carries the pinned
      Agent Profile version (FK + content digest) — later Profile publishes
      never affect an in-flight run — plus coordinator affinity, opaque
      workspace identity, lease state, durable availability throttling, and
      the pinned opaque recovery identity. No Host paths, no artifact bytes.
    -->
    <changeSet id="007-workflows-create-orchestration-runs" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="orchestration_runs"/></not>
        </preConditions>
        <createTable tableName="orchestration_runs">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workflow_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <!-- §16.1 pin: the published version at request creation -->
            <column name="profile_version_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="profile_version_digest" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <!-- coordinator affinity (§16.4) -->
            <column name="coordinator_agent_id" type="uuid"/>
            <column name="coordinator_host_id" type="uuid"/>
            <!-- opaque Host workspace identity (§17.1) -->
            <column name="workspace_id" type="varchar(100)"/>
            <column name="workspace_generation" type="integer"/>
            <column name="lease_state" type="varchar(20)"/>
            <column name="lease_deadline" type="timestamp with time zone"/>
            <!-- affinity recovery (§16.4: 15-min default, never extended) -->
            <column name="affinity_recovery_deadline" type="timestamp with time zone"/>
            <!-- durable availability throttling (§16.4) -->
            <column name="availability_state" type="varchar(20)" defaultValue="AVAILABLE"/>
            <column name="availability_episode" type="integer" defaultValue="0"/>
            <column name="availability_occurrence" type="integer" defaultValue="0"/>
            <!-- pinned opaque recovery identity (§17.2) -->
            <column name="recovery_provider_id" type="varchar(100)"/>
            <column name="recovery_provider_version" type="varchar(50)"/>
            <column name="recovery_config_digest" type="varchar(64)"/>
            <column name="current_continuation_id" type="varchar(100)"/>
            <column name="current_snapshot_id" type="varchar(100)"/>
            <column name="current_snapshot_digest" type="varchar(64)"/>
            <column name="snapshot_expires_at" type="timestamp with time zone"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="007-workflows-runs-fk-request" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="orchestration_runs"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_orchestration_runs_request"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="orchestration_runs"
