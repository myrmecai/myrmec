        <preConditions onFail="MARK_RAN">
            <tableExists tableName="execution_events"/>
            <tableExists tableName="task_attempts"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_execution_events_attempt"/></not>
        </preConditions>
        <addForeignKeyConstraint
