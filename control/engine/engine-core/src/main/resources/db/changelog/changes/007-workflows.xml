            onDelete="SET NULL"/>
    </changeSet>

    <!-- Foreign key to agent_instances (agents table) -->
    <changeSet id="007-workflows-tasks-fk-agent-instance" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_workflow_tasks_agent_instance"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="workflow_tasks"
            baseColumnNames="agent_instance_id"
            referencedTableName="agents"
            referencedColumnNames="id"
            constraintName="fk_workflow_tasks_agent_instance"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- Index for looking up tasks by request -->
    <changeSet id="007-workflows-tasks-idx-request-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <not><indexExists indexName="idx_workflow_tasks_request_id"/></not>
        </preConditions>
        <createIndex tableName="workflow_tasks" indexName="idx_workflow_tasks_request_id">
            <column name="request_id"/>
        </createIndex>
    </changeSet>

    <!-- Index for filtering by status (task queue) -->
    <changeSet id="007-workflows-tasks-idx-status" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <not><indexExists indexName="idx_workflow_tasks_status"/></not>
        </preConditions>
        <createIndex tableName="workflow_tasks" indexName="idx_workflow_tasks_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- Index for looking up tasks by agent instance -->
    <changeSet id="007-workflows-tasks-idx-agent-instance" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <not><indexExists indexName="idx_workflow_tasks_agent_instance_id"/></not>
        </preConditions>
        <createIndex tableName="workflow_tasks" indexName="idx_workflow_tasks_agent_instance_id">
            <column name="agent_instance_id"/>
        </createIndex>
    </changeSet>

    <!-- Index for status + next_eligible_at (rate-limit retry dispatcher) -->
    <changeSet id="007-workflows-tasks-idx-status-next-eligible" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <not><indexExists indexName="idx_workflow_tasks_status_next_eligible"/></not>
        </preConditions>
        <createIndex tableName="workflow_tasks" indexName="idx_workflow_tasks_status_next_eligible">
            <column name="status"/>
            <column name="next_eligible_at"/>
        </createIndex>
    </changeSet>

    <!-- Index for querying pending approvals -->
    <changeSet id="007-workflows-tasks-idx-approval-status" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <not><indexExists indexName="idx_workflow_tasks_approval_status"/></not>
        </preConditions>
        <createIndex tableName="workflow_tasks" indexName="idx_workflow_tasks_approval_status">
            <column name="approval_status"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================== -->
    <!-- EXECUTION_EVENTS                                                   -->
    <!-- ================================================================== -->

    <changeSet id="007-workflows-create-execution-events" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="execution_events"/>
            </not>
        </preConditions>
        <createTable tableName="execution_events">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="attempt_id" type="uuid"/>
            <column name="event_type" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="log_level" type="varchar(10)"/>
            <column name="message" type="text"/>
            <column name="data" type="text"/>
            <column name="progress" type="integer"/>
            <column name="tool_name" type="varchar(100)"/>
            <column name="tool_call_id" type="varchar(100)"/>
            <column name="duration_ms" type="bigint"/>
            <column name="is_error" type="boolean"/>
            <column name="source" type="varchar(20)" defaultValue="TASK">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Foreign key to workflow_tasks -->
    <changeSet id="007-workflows-events-fk-task" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="execution_events"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_execution_events_task"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="execution_events"
            baseColumnNames="task_id"
            referencedTableName="workflow_tasks"
            referencedColumnNames="id"
            constraintName="fk_execution_events_task"
            onDelete="CASCADE"/>
    </changeSet>

    <!-- Index for fetching events by task (most common query) -->
    <changeSet id="007-workflows-events-idx-task-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="execution_events"/>
            <not><indexExists indexName="idx_execution_events_task_id"/></not>
        </preConditions>
        <createIndex tableName="execution_events" indexName="idx_execution_events_task_id">
            <column name="task_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- Index for querying events by attempt -->
    <changeSet id="007-workflows-events-idx-attempt-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="execution_events"/>
            <not><indexExists indexName="idx_execution_events_attempt_id"/></not>
        </preConditions>
        <createIndex tableName="execution_events" indexName="idx_execution_events_attempt_id">
            <column name="attempt_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================== -->
    <!-- TASK_ATTEMPTS                                                      -->
    <!-- ================================================================== -->

    <changeSet id="007-workflows-create-task-attempts" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="task_attempts"/>
            </not>
        </preConditions>
        <createTable tableName="task_attempts">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="attempt_number" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="agent_instance_id" type="uuid"/>
            <column name="status" type="varchar(20)" defaultValue="RUNNING">
                <constraints nullable="false"/>
            </column>
            <column name="result" type="varchar(20)"/>
            <column name="output" type="text"/>
            <column name="error_message" type="text"/>
            <column name="error_code" type="varchar(50)"/>
            <column name="started_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <!-- Unique constraint: one attempt number per task -->
    <changeSet id="007-workflows-attempts-uk-task-attempt" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="task_attempts"/>
            <not><indexExists indexName="uk_task_attempts_task_attempt"/></not>
        </preConditions>
        <addUniqueConstraint
            tableName="task_attempts"
            columnNames="task_id, attempt_number"
            constraintName="uk_task_attempts_task_attempt"/>
    </changeSet>

    <!-- FK to workflow_tasks -->
    <changeSet id="007-workflows-attempts-fk-task" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="task_attempts"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_task_attempts_task"/></not>
