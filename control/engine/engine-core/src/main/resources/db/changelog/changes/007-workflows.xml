<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Squashed workflows changelog.

        Replaces the following incremental changesets:
          - 20260405-04-workflows.xml
          - 20260405-05-requests.xml
          - 20260405-06-tasks.xml
          - 20260411-01-execution-events.xml
          - 20260412-01-execution-event-source.xml
          - 20260412-02-task-attempts-artifacts.xml
          - 20260419-01-workflow-request-branch.xml
          - 20260525-02-task-metrics.xml
          - 20260608-02-execution-snapshots.xml
          - 20260608-04-task-retry-backoff.xml
          - 20260621-10-execution-snapshot-attribution.xml
          - 20260623-02-workflow-tasks-execution-approvals.xml
          - 20260811-01-workflow-task-pause.xml
          - F10 orchestration persistence (design §16.7):
            orchestration_runs, orchestration_dispatches, task-attempt
            result id/digest, execution-events source id/sequence,
            execution-snapshots source id, agent_hosts PSK columns
    -->

    <!-- ================================================================== -->
    <!-- WORKFLOWS                                                          -->
    <!-- ================================================================== -->

    <changeSet id="007-workflows-create-workflows" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workflows"/>
            </not>
        </preConditions>
        <createTable tableName="workflows">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="steps" type="text" defaultValue="[]">
                <constraints nullable="false"/>
            </column>
            <column name="input_schema" type="text"/>
            <column name="artifacts_repo" type="text"/>
            <column name="version" type="integer" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Unique constraint: workflow name per project -->
    <changeSet id="007-workflows-uk-project-name" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflows"/>
            <not><uniqueConstraintExists tableName="workflows" constraintName="uk_workflows_project_name"/></not>
        </preConditions>
        <addUniqueConstraint tableName="workflows"
                             columnNames="project_id, name"
                             constraintName="uk_workflows_project_name"/>
    </changeSet>

    <!-- Foreign key to projects -->
    <changeSet id="007-workflows-fk-project" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflows"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_workflows_project"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="workflows"
            baseColumnNames="project_id"
            referencedTableName="projects"
            referencedColumnNames="id"
            constraintName="fk_workflows_project"
            onDelete="CASCADE"/>
    </changeSet>

    <!-- Foreign key to users (created_by) -->
    <changeSet id="007-workflows-fk-user" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflows"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_workflows_user"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="workflows"
            baseColumnNames="created_by"
            referencedTableName="users"
            referencedColumnNames="id"
            constraintName="fk_workflows_user"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- Index for looking up workflows by project -->
    <changeSet id="007-workflows-idx-project-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflows"/>
            <not><indexExists indexName="idx_workflows_project_id"/></not>
        </preConditions>
        <createIndex tableName="workflows" indexName="idx_workflows_project_id">
            <column name="project_id"/>
        </createIndex>
    </changeSet>

    <!-- Index for filtering by status -->
    <changeSet id="007-workflows-idx-status" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflows"/>
            <not><indexExists indexName="idx_workflows_status"/></not>
        </preConditions>
        <createIndex tableName="workflows" indexName="idx_workflows_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================== -->
    <!-- WORKFLOW_REQUESTS                                                  -->
    <!-- ================================================================== -->

    <changeSet id="007-workflows-create-workflow-requests" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workflow_requests"/>
            </not>
        </preConditions>
        <createTable tableName="workflow_requests">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workflow_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="workflow_version" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="input" type="text"/>
            <column name="output" type="text"/>
            <column name="status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="text"/>
            <column name="branch" type="varchar(200)"/>
            <column name="created_by" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="timestamp with time zone"/>
            <column name="completed_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <!-- Foreign key to workflows -->
    <changeSet id="007-workflows-req-fk-workflow" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_requests"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_workflow_requests_workflow"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="workflow_requests"
            baseColumnNames="workflow_id"
            referencedTableName="workflows"
            referencedColumnNames="id"
            constraintName="fk_workflow_requests_workflow"
            onDelete="CASCADE"/>
    </changeSet>

    <!-- Foreign key to users (created_by) -->
    <changeSet id="007-workflows-req-fk-user" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_requests"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_workflow_requests_user"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="workflow_requests"
            baseColumnNames="created_by"
            referencedTableName="users"
            referencedColumnNames="id"
            constraintName="fk_workflow_requests_user"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- Index for looking up requests by workflow -->
    <changeSet id="007-workflows-req-idx-workflow-id" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_requests"/>
            <not><indexExists indexName="idx_workflow_requests_workflow_id"/></not>
        </preConditions>
        <createIndex tableName="workflow_requests" indexName="idx_workflow_requests_workflow_id">
            <column name="workflow_id"/>
        </createIndex>
    </changeSet>

    <!-- Index for filtering by status -->
    <changeSet id="007-workflows-req-idx-status" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_requests"/>
            <not><indexExists indexName="idx_workflow_requests_status"/></not>
        </preConditions>
        <createIndex tableName="workflow_requests" indexName="idx_workflow_requests_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- Index for filtering by created_at (recent requests) -->
    <changeSet id="007-workflows-req-idx-created-at" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_requests"/>
            <not><indexExists indexName="idx_workflow_requests_created_at"/></not>
        </preConditions>
        <createIndex tableName="workflow_requests" indexName="idx_workflow_requests_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================== -->
    <!-- WORKFLOW_TASKS                                                     -->
    <!-- ================================================================== -->

    <changeSet id="007-workflows-create-workflow-tasks" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="workflow_tasks"/>
            </not>
        </preConditions>
        <createTable tableName="workflow_tasks">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="request_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="step_id" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="agent_profile_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="agent_instance_id" type="uuid"/>
            <column name="input" type="text"/>
            <column name="output" type="text"/>
            <column name="status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="result" type="varchar(20)"/>
            <column name="error_message" type="text"/>
            <column name="attempt" type="integer" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="timestamp with time zone"/>
            <column name="completed_at" type="timestamp with time zone"/>
            <column name="knowledge_source_ids" type="text"/>
            <column name="current_attempt_id" type="uuid"/>
            <column name="next_eligible_at" type="timestamp with time zone"/>
            <column name="metrics" type="text"/>
            <column name="requires_approval" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="approval_status" type="varchar(20)"/>
            <column name="approval_payload" type="text"/>
            <column name="approval_requested_at" type="timestamp with time zone"/>
            <column name="approval_expires_at" type="timestamp with time zone"/>
            <column name="pause_mode" type="varchar(10)"/>
            <column name="pause_state" type="varchar(20)" defaultValue="NONE"/>
            <column name="paused_at" type="timestamp with time zone"/>
            <column name="paused_by_user_id" type="uuid"/>
            <column name="pause_reason" type="text"/>
            <column name="max_retries" type="int" defaultValueNumeric="0"/>
        </createTable>
    </changeSet>

    <!-- Unique constraint: one task per step per request per attempt -->
    <changeSet id="007-workflows-tasks-uk-request-step-attempt" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <not><uniqueConstraintExists tableName="workflow_tasks" constraintName="uk_workflow_tasks_request_step_attempt"/></not>
        </preConditions>
        <addUniqueConstraint tableName="workflow_tasks"
                             columnNames="request_id, step_id, attempt"
                             constraintName="uk_workflow_tasks_request_step_attempt"/>
    </changeSet>

    <!-- Foreign key to workflow_requests -->
    <changeSet id="007-workflows-tasks-fk-request" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_workflow_tasks_request"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="workflow_tasks"
            baseColumnNames="request_id"
            referencedTableName="workflow_requests"
            referencedColumnNames="id"
            constraintName="fk_workflow_tasks_request"
            onDelete="CASCADE"/>
    </changeSet>

    <!-- Foreign key to agent_profiles -->
    <changeSet id="007-workflows-tasks-fk-agent-profile" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="workflow_tasks"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_workflow_tasks_agent_profile"/></not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="workflow_tasks"
