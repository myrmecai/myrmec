            referencedColumnNames="id"
            constraintName="fk_orchestration_runs_profile_version"/>
    </changeSet>

    <changeSet id="007-workflows-runs-idx-workflow" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="orchestration_runs"/>
            <not><indexExists indexName="idx_orchestration_runs_workflow"/></not>
