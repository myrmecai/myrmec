        <createIndex tableName="orchestration_runs" indexName="idx_orchestration_runs_workflow">
            <column name="workflow_id"/>
        </createIndex>
    </changeSet>

    <!--
      orchestration_dispatches: canonical assignment bytes committed before
      any WebSocket send; the relay retransmits these exact bytes until
      inference.accept (§16.3). dispatch_id == the task attempt UUID in V1.
    -->
    <changeSet id="007-workflows-create-orchestration-dispatches" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="orchestration_dispatches"/></not>
        </preConditions>
        <createTable tableName="orchestration_dispatches">
            <column name="dispatch_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="run_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="task_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="assignment" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="assignment_digest" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_state" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="send_count" type="integer" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="sent_at" type="timestamp with time zone"/>
            <column name="accepted_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <changeSet id="007-workflows-dispatches-fk-run" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="orchestration_dispatches"/>
