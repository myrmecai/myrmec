<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Seed the governance_profile_code system setting (default: STANDARD).
      This is the org-level governance profile selection. Read by
      ContextBuilder and GovernanceProfileService.
    -->
    <changeSet id="20260702-01-governance-profile-default-setting" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="system_settings"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM system_settings WHERE setting_key = 'governance_profile_code'
            </sqlCheck>
        </preConditions>

        <insert tableName="system_settings">
            <column name="setting_key" value="governance_profile_code"/>
            <column name="value_type" value="STRING"/>
            <column name="setting_value" value="STANDARD"/>
            <column name="description" value="The org-level governance profile code (STRICT, STANDARD, or FLEXIBLE)."/>
        </insert>
    </changeSet>

</databaseChangeLog>