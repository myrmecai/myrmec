<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ================================================================
         model_providers
         ================================================================ -->
    <changeSet id="004-models-create-model-providers" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="model_providers"/>
            </not>
        </preConditions>
        <comment>Create model_providers table for AI provider configurations</comment>

        <createTable tableName="model_providers">
            <column name="code" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="base_url" type="varchar(500)"/>
            <column name="deployment_type" type="varchar(20)" defaultValue="CLOUD">
                <constraints nullable="false"/>
            </column>
            <column name="requires_auth" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="docs_url" type="varchar(500)"/>
            <column name="description" type="text"/>
            <column name="is_system" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="connection_config_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <!-- ================================================================
         models
         ================================================================ -->

    <!-- ================================================================
         model_capabilities
         ================================================================ -->
    <changeSet id="004-models-create-model-capabilities" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="model_capabilities"/>
            </not>
        </preConditions>
        <comment>Reference table for model capabilities (vision, embedding, thinking, etc.)</comment>

        <createTable tableName="model_capabilities">
            <column name="code" type="varchar(30)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="is_system" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ================================================================
         models
         ================================================================ -->
    <changeSet id="004-models-create-models" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="models"/>
            </not>
        </preConditions>
        <comment>Create models table for AI model configurations</comment>

        <createTable tableName="models">
            <column name="code" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="varchar(50)">
                <constraints nullable="false" foreignKeyName="fk_models_provider" references="model_providers(code)"/>
            </column>
            <column name="model_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="api_endpoint" type="varchar(500)"/>
            <column name="infra_config" type="text"/>
            <column name="default_params" type="text"/>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="health_status" type="varchar(20)" defaultValue="UNKNOWN">
                <constraints nullable="false"/>
            </column>
            <column name="last_health_check" type="timestamp with time zone"/>
            <column name="last_tested_at" type="timestamp with time zone"/>
            <column name="last_test_status" type="varchar(20)"/>
            <column name="input_price" type="numeric(10,6)"/>
            <column name="output_price" type="numeric(10,6)"/>
            <column name="currency" type="varchar(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="context_window_tokens" type="int"/>
            <column name="max_output_tokens" type="int"/>
            <column name="training_cutoff_date" type="date"/>
            <column name="release_date" type="date"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone"/>
        </createTable>

        <createIndex indexName="idx_models_status" tableName="models">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_models_provider" tableName="models">
            <column name="provider"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================
         model_capability_bindings
         ================================================================ -->
    <changeSet id="004-models-create-model-capability-bindings" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="model_capability_bindings"/>
            </not>
        </preConditions>
        <comment>Many-to-many bindings between models and capabilities, with optional per-capability parameters</comment>

        <createTable tableName="model_capability_bindings">
            <column name="model_code" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="capability_code" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="parameters" type="text"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="model_capability_bindings"
            columnNames="model_code, capability_code"
            constraintName="pk_model_capability_bindings"/>

        <addForeignKeyConstraint
            baseTableName="model_capability_bindings"
            baseColumnNames="model_code"
            constraintName="fk_mcb_model"
            referencedTableName="models"
            referencedColumnNames="code"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="model_capability_bindings"
            baseColumnNames="capability_code"
            constraintName="fk_mcb_capability"
            referencedTableName="model_capabilities"
            referencedColumnNames="code"
            onDelete="CASCADE"/>

        <createIndex indexName="idx_mcb_capability" tableName="model_capability_bindings">
            <column name="capability_code"/>
        </createIndex>
    </changeSet>

    <!-- ================================================================
         Cross-file FKs
         ================================================================ -->

    <!-- model_providers.connection_config_id → connection_configs(id)
         — connection_configs created in 007b-ai-context.xml -->
    <changeSet id="004-models-add-connection-config-fk" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_mp_connection_config"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="model_providers"
            baseColumnNames="connection_config_id"
            referencedTableName="connection_configs"
            referencedColumnNames="id"
            constraintName="fk_mp_connection_config"
            onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>