<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Phase 9a — Execution snapshots.

        Each row captures the full inputs + outputs + context of a single
        engine-side event (turn dispatch, task dispatch, approval
        decision, etc.) so V2 replay has months of history to work from.

        Design notes (zero-downtime tiered-storage migration in V1.1):
          * ``payload_json`` carries the inline payload. Capped at 256KB
            by SnapshotWriter; truncation flagged via ``truncated``.
          * ``payload_uri`` + ``payload_sha256`` are RESERVED for V1.1
            tiered storage — when an external store (S3 etc.) becomes
            available the writer can stash large payloads there and
            null out ``payload_json``. Shipping both columns now means
            the migration is a code-only change, not a schema change.
          * ``sampled`` lets the writer record that a row was kept
            deliberately (vs. dropped by sampling policy) — useful for
            auditing the sampling itself.
          * Monthly partitioning is a Postgres-only concern and is
            intentionally NOT in this changeset (H2 in tests can't do
            it). A Postgres-specific follow-up will add
            ``PARTITION BY RANGE (created_at)``.
    -->

    <changeSet id="20260608-02-01" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="execution_snapshots"/>
            </not>
        </preConditions>
        <createTable tableName="execution_snapshots">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_exec_snap_project"
                             references="projects(id)"/>
            </column>
            <column name="agent_id" type="uuid">
                <constraints nullable="true"
                             foreignKeyName="fk_exec_snap_agent"
                             references="agent_hosts(id)"/>
            </column>
            <column name="conversation_id" type="uuid">
                <constraints nullable="true"
                             foreignKeyName="fk_exec_snap_conv"
                             references="conversations(id)"/>
            </column>
            <column name="message_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <!-- workflow_id + step_run_id intentionally NOT foreign-keyed:
                 workflow_requests rows may roll over before snapshots and
                 a missing FK is friendlier than an aborted snapshot
                 write. message_id is also un-FK'd because the writer may
                 be invoked from a sibling transaction that can't yet see
                 the just-inserted message row. -->
            <column name="workflow_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="step_run_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="event_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="payload_json" type="clob">
                <constraints nullable="true"/>
            </column>
            <column name="payload_uri" type="varchar(500)">
                <constraints nullable="true"/>
            </column>
            <column name="payload_sha256" type="char(64)">
                <constraints nullable="true"/>
            </column>
            <column name="size_bytes" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="truncated" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="sampled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260608-02-02" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_exec_snap_project_created"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_exec_snap_project_created"
                     tableName="execution_snapshots">
            <column name="project_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260608-02-03" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_exec_snap_conv_created"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_exec_snap_conv_created"
                     tableName="execution_snapshots">
            <column name="conversation_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260608-02-04" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_exec_snap_event_type"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_exec_snap_event_type"
                     tableName="execution_snapshots">
            <column name="event_type"/>
        </createIndex>
    </changeSet>

    <!--
        Per-project retention + sampling knobs. retention_days governs
        the (future) snapshot pruner; snapshot_sampling_rate is a
        0.0–1.0 probability the writer uses to decide whether to keep
        an inbound event at all. Default 90 days + 100% sampling so
        upgrade installs preserve everything until an admin tunes it
        down.
    -->
    <changeSet id="20260608-02-05" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="projects" columnName="snapshot_retention_days"/>
            </not>
        </preConditions>
        <addColumn tableName="projects">
            <column name="snapshot_retention_days" type="int" defaultValueNumeric="90">
                <constraints nullable="false"/>
            </column>
            <column name="snapshot_sampling_rate" type="numeric(4,3)" defaultValueNumeric="1.000">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
