<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Phase 5a — RAG schema: knowledge_bases / knowledge_sources / knowledge_chunks.
        Three new tables sit beside the existing ``knowledge_documents`` table
        (which keeps doing what it did pre-Phase-5: injecting org/project
        standards into agent task context). The split lets RAG evolve
        independently from the always-on knowledge surface.

        Scope discrimination is on ``knowledge_bases``:
          - SYSTEM  → project_id NULL, group_id NULL
          - GROUP   → project_id NULL, group_id NOT NULL
          - PROJECT → project_id NOT NULL, group_id NULL
        ProjectAccessEvaluator + GroupAccessEvaluator enforce visibility.
    -->

    <changeSet id="20260606-01-create-knowledge-bases" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="knowledge_bases"/>
            </not>
        </preConditions>
        <comment>Knowledge base: the unit of RAG visibility + provider routing.</comment>

        <createTable tableName="knowledge_bases">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <!-- PROJECT / GROUP / SYSTEM — matches KnowledgeBaseScope enum -->
            <column name="scope" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_knowledge_base_project"
                             references="projects(id)"/>
            </column>
            <column name="group_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_knowledge_base_group"
                             references="groups(id)"/>
            </column>
            <!-- Matches RetrievalProvider#id(). Engine picks the matching @Component at query time. -->
            <column name="provider_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <!-- Provider-specific configuration as JSON. -->
            <column name="provider_config" type="text"/>
            <column name="created_by" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_knowledge_base_created_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260606-01-knowledge-bases-scope-check" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM information_schema.check_constraints
                    WHERE constraint_name = 'chk_knowledge_base_scope'
                </sqlCheck>
            </not>
        </preConditions>
        <comment>Enforce scope vs project_id / group_id consistency.</comment>
        <sql>
            ALTER TABLE knowledge_bases ADD CONSTRAINT chk_knowledge_base_scope
            CHECK (
                (scope = 'SYSTEM'  AND project_id IS NULL  AND group_id IS NULL) OR
                (scope = 'GROUP'   AND project_id IS NULL  AND group_id IS NOT NULL) OR
                (scope = 'PROJECT' AND project_id IS NOT NULL AND group_id IS NULL)
            );
        </sql>
    </changeSet>

    <changeSet id="20260606-01-knowledge-bases-name-uniqueness" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_knowledge_base_scope_owner_name"/>
            </not>
        </preConditions>
        <!--
            Names unique per (scope, owner) tuple. coalesce so SYSTEM rows
            (both null) still get deduped by name alone, GROUP by (group_id, name),
            PROJECT by (project_id, name).
        -->
        <createIndex indexName="uq_knowledge_base_scope_owner_name"
                     tableName="knowledge_bases" unique="true">
            <column name="scope"/>
            <column name="project_id"/>
            <column name="group_id"/>
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260606-01-knowledge-bases-lookup-indexes" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_knowledge_base_project_id"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_knowledge_base_project_id" tableName="knowledge_bases">
            <column name="project_id"/>
        </createIndex>
        <createIndex indexName="idx_knowledge_base_group_id" tableName="knowledge_bases">
            <column name="group_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260606-01-create-knowledge-sources" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="knowledge_sources"/>
            </not>
        </preConditions>
        <comment>Knowledge source: one external system feeding chunks into a KB.</comment>

        <createTable tableName="knowledge_sources">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="knowledge_base_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_knowledge_source_kb"
                             references="knowledge_bases(id)"/>
            </column>
            <!-- Matches KnowledgeSourceConnector#type(). -->
            <column name="connector_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="uri" type="varchar(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="config_json" type="text"/>
            <!-- Per-source schedule (cron expr); null = manual sync only. -->
            <column name="sync_schedule" type="varchar(100)"/>
            <!-- Last sync bookkeeping for UI status surface. -->
            <column name="last_sync_at" type="timestamp with time zone"/>
            <column name="last_sync_status" type="varchar(20)"/>
            <column name="last_sync_chunks" type="bigint"/>
            <column name="last_sync_error_count" type="int"/>
            <column name="last_sync_duration_ms" type="bigint"/>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260606-01-knowledge-sources-name-uniqueness" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_knowledge_source_kb_name"/>
            </not>
        </preConditions>
        <createIndex indexName="uq_knowledge_source_kb_name"
                     tableName="knowledge_sources" unique="true">
            <column name="knowledge_base_id"/>
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260606-01-knowledge-sources-enabled-index" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_knowledge_source_enabled"/>
            </not>
        </preConditions>
        <!-- Scheduler scans enabled rows with non-null sync_schedule. -->
        <createIndex indexName="idx_knowledge_source_enabled" tableName="knowledge_sources">
            <column name="enabled"/>
            <column name="sync_schedule"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260606-01-create-knowledge-chunks" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="knowledge_chunks"/>
            </not>
        </preConditions>
        <comment>Knowledge chunk: one indexable unit produced by a source sync.
            Embeddings live in the retrieval provider (Ragflow / external vector
            store); engine stores only the text + locator + metadata so it can
            re-index on demand and answer side-panel "show passage" requests.
        </comment>

        <createTable tableName="knowledge_chunks">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="knowledge_source_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_knowledge_chunk_source"
                             references="knowledge_sources(id)"/>
            </column>
            <column name="locator" type="varchar(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="text">
                <constraints nullable="false"/>
            </column>
            <!-- SHA-256 of content for idempotent re-syncs. -->
            <column name="content_hash" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="metadata_json" type="text"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260606-01-knowledge-chunks-source-locator-uniqueness" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="uq_knowledge_chunk_source_locator"/>
            </not>
        </preConditions>
        <!-- A single (source, locator) yields one row even across re-syncs;
             connector upserts by this tuple. -->
        <createIndex indexName="uq_knowledge_chunk_source_locator"
                     tableName="knowledge_chunks" unique="true">
            <column name="knowledge_source_id"/>
            <column name="locator"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
