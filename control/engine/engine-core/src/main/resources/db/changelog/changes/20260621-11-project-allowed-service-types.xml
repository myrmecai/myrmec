<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      #77 — per-project allowed service types. A project may host only the
      service types its operators opted into; every create of a service of type
      T is gated by `@projectAccess.allowsServiceType(projectId, T)`.

      Stored as a JSON text array (same shape + JsonListConverter as
      assistant_version.usable_via) rather than a native text[]/jsonb so the
      column behaves identically on PostgreSQL and the H2 test database. NOT
      NULL with a default of both shipped types so existing projects keep
      hosting everything they could before (dev-stage: no grandfather/archive
      logic — narrowing is accepted as destructive).
    -->

    <changeSet id="20260621-11-project-allowed-service-types" author="myrmec">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="projects" columnName="allowed_service_types"/>
            </not>
        </preConditions>
        <addColumn tableName="projects">
            <column name="allowed_service_types" type="text"
                    defaultValue='["WORKFLOW","CONVERSATIONAL"]'>
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
