---
// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 The Myrmec Authors

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const nav = [
  { href: "/v2/", label: "Home" },
  { href: "/v2/use-cases", label: "Use Cases" },
  { href: "/v2/security", label: "Security" },
  { href: "/v2/get-started", label: "Get Started" },
  { href: "/v2/roadmap", label: "Roadmap" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-white font-sans text-slate-700 antialiased">
    <!-- ─── HEADER ─────────────────────────────────────────────── -->
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 md:px-10">
        <a href="/v2/" class="flex items-center gap-3 text-xl font-extrabold tracking-tight text-slate-900">
          <img src="/logo-mark.svg" alt="Myrmec" class="h-8 w-8" />
          <span>MYRMEC</span>
        </a>

        <nav class="hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex">
          {nav.map((item) => (
            <a href={item.href} class="transition hover:text-indigo-600">{item.label}</a>
          ))}
          <a href="/v2/#contact" class="transition hover:text-indigo-600">Contact</a>
        </nav>

        <div class="flex items-center gap-3">
          <span class="hidden rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 sm:inline-flex">
            Open Source · Apache-2.0
          </span>
          <a
            href="/v2/get-started"
            class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500"
          >Get Started</a>
        </div>
      </div>
    </header>

    <!-- ─── MAIN ───────────────────────────────────────────────── -->
    <main>
      <slot />
    </main>

    <!-- ─── FOOTER ─────────────────────────────────────────────── -->
    <footer class="mt-24 border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-6 py-12 md:px-10">
        <div class="grid gap-10 md:grid-cols-4">
          <div class="md:col-span-2">
            <div class="flex items-center gap-3">
              <img src="/logo-mark.svg" alt="Myrmec" class="h-7 w-7" />
              <p class="text-lg font-extrabold tracking-tight text-slate-900">MYRMEC</p>
            </div>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-500">
              The governed runtime where agents read your organisation's truth and act on it
              under audit. Grounded. Sandboxed. Approved.
            </p>
          </div>

          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Product</p>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="/v2/" class="text-slate-600 transition hover:text-indigo-600">Home</a></li>
              <li><a href="/v2/use-cases" class="text-slate-600 transition hover:text-indigo-600">Use Cases</a></li>
              <li><a href="/v2/security" class="text-slate-600 transition hover:text-indigo-600">Security</a></li>
              <li><a href="/v2/get-started" class="text-slate-600 transition hover:text-indigo-600">Get Started</a></li>
              <li><a href="/v2/roadmap" class="text-slate-600 transition hover:text-indigo-600">Roadmap</a></li>
              <li><a href="/v2/#contact" class="text-slate-600 transition hover:text-indigo-600">Contact Us</a></li>
            </ul>
          </div>

          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Community</p>
            <ul class="mt-4 space-y-3 text-sm">
              <li>
                <a href="https://github.com/myrmec" class="flex items-center gap-2 text-slate-600 transition hover:text-indigo-600">
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
                  GitHub
                </a>
              </li>
              <li><a href="https://discord.gg/myrmec" class="text-slate-600 transition hover:text-indigo-600">Discord</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 border-t border-slate-200 pt-6 text-xs text-slate-400">
          Copyright {new Date().getFullYear()} Myrmec. Apache-2.0 licensed.
        </div>
      </div>
    </footer>
  </body>
</html>
