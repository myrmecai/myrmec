const engineering = [
  ["Code Generation", "Bring AI coding standards, architecture decisions, and review criteria into reusable workflows. Every developer benefits from the same governed approach instead of relying on individual prompt skill."],
  ["Code Review & Quality Gates", "Run review workflows that check code against your own standards, invoke static-analysis agents, and produce a structured report. Consistent, traceable, never blocked on one reviewer's availability."],
  ["Documentation Generation", "Read source code and knowledge context, then produce API references, architecture decision records, or user guides — versioned and auditable."],
  ["Test Generation", "Assign a test-writing agent profile to a workflow step and automatically produce unit, integration, or regression tests from code or specifications."],
  ["Autonomous Maintenance", "Schedule a recurring workflow that scans a repository for deprecated libraries, writes the upgrade code, runs the tests, and submits a report — without a developer opening an IDE."],
  ["Architectural Compliance", "An agent reviews each new module against the organisation's architecture knowledge source and flags violations automatically."],
  ["Legacy Code Migration", "A non-technical project manager triggers a migration workflow that transforms, for example, a Java 8 project to Spring Boot 3 using company-approved patterns stored in Myrmec."],
];

const operations = [
  ["Data Processing & Transformation", "Connect specialised agents to pipeline steps for extraction, normalisation, validation, and loading — with full observability across every run."],
  ["Compliance & Policy Checks", "Run regulatory or internal policy reviews as automated workflow steps, producing evidence trails that can be exported for audit."],
  ["Incident Analysis", "Feed logs, traces, and runbooks into an analysis workflow that produces structured root-cause reports faster than manual investigation."],
  ["Onboarding & Knowledge Transfer", "Project-level knowledge lets agents answer questions about a project's history, business logic, and quirks — a 24/7 technical lead for new joiners."],
