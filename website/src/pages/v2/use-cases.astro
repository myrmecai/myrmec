const sessions = [
  {
    title: "Ops Runbook Copilot",
    body: "An on-call engineer chats: \"Reset the staging environment.\" The agent retrieves the runbook from the infra-docs repo, proposes four steps, and surfaces each kubectl / terraform command as an approval card citing the runbook section. The engineer approves four times. Nothing ran on the engineer's laptop — and the full session is recorded in the audit log.",
  },
  {
    title: "NL→SQL Data Analyst",
    body: "An analyst asks: \"What's our MRR by region last quarter?\" The agent retrieves the data dictionary, the regional join definition, and the fiscal-quarter rule. Generates SQL → approval card with the query and estimated row count → approved → results stream back with citations to both the schema docs and the SQL that produced them. Database credentials never leave the sandbox.",
  },
  {
    title: "Compliance Q&A",
    body: "\"What's our data-retention policy for EU customers?\" The agent retrieves from the policy repository, cites the GDPR clause and the matching internal policy section, and produces a structured answer. When the regulator asks how the answer was produced six months later, the Auditor replays the session.",
  },
  {
    title: "Code-aware Operations",
    body: "\"Where do we handle webhook retry on Stripe failures?\" The agent searches the monorepo and returns the answer with file:line citations — and if asked, opens a PR fixing a bug it spots, with the diff surfaced as an approval card before the push.",
  },
  {
    title: "Vendor Onboarding Assistant",
    body: "Procurement chats with an agent grounded in vendor policy and previous vendor records. It walks them through compliance questions, files Jira tickets via approved tools, and produces a final dossier for sign-off.",
  },
