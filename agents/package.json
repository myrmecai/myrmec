{
  "name": "@myrmec/agent",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./supervisor/index.js": {
      "types": "./dist/supervisor/index.d.ts",
      "require": "./dist/supervisor/index.cjs",
      "default": "./dist/supervisor/index.js"
    },
    "./supervisor/AgentSupervisor.js": {
      "types": "./dist/supervisor/AgentSupervisor.d.ts",
      "require": "./dist/supervisor/AgentSupervisor.cjs",
      "default": "./dist/supervisor/AgentSupervisor.js"
    },
    "./transport/httpClient.js": {
      "types": "./dist/transport/httpClient.d.ts",
      "require": "./dist/transport/httpClient.cjs",
      "default": "./dist/transport/httpClient.js"
    },
    "./worker/AgentWorkerHost.js": {
      "types": "./dist/worker/AgentWorkerHost.d.ts",
      "require": "./dist/worker/AgentWorkerHost.cjs",
      "default": "./dist/worker/AgentWorkerHost.js"
    },
    "./models/index.js": {
      "types": "./dist/models/index.d.ts",
      "require": "./dist/models/index.cjs",
      "default": "./dist/models/index.js"
    },
    "./protocol/envelope.js": {
      "types": "./dist/protocol/envelope.d.ts",
      "require": "./dist/protocol/envelope.cjs",
      "default": "./dist/protocol/envelope.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/build-cjs.cjs && node scripts/rename-cjs.cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "node scripts/build-cjs.cjs",
    "dev": "tsx watch src/bin/headless.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "dependencies": {
    "@langchain/anthropic": "^1.5.0",
    "@langchain/core": "^1.2.0",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/openai": "^1.5.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
